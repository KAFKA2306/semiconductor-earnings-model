{
  "schema_version": "nand-kpi-source-registry.v1",
  "policy": {
    "purpose": "Discover and parse NAND ASP and bit-shipment disclosures from official company investor-relations materials.",
    "allowed_source_tiers": ["primary_company"],
    "allowed_document_types": ["earnings_prepared_remarks", "earnings_presentation", "earnings_release"],
    "rules": [
      "Only official company domains are allowed.",
      "Preserve the reported text before converting qualitative bands to numeric intervals.",
      "Preserve a separate official period source when the KPI document does not state an exact quarter-end date.",
      "Company guidance must match the same company, KPI, scope and reporting period as the actual before comparison.",
      "Missing or non-disclosed guidance remains missing.",
      "Unprocessed and newly discovered documents are selected before previously processed documents.",
      "Candidate limits and skipped URLs must remain visible in the collection state."
    ]
  },
