{
  "schema_version": "financial-metric-catalog.v1",
  "design_policy": [
    "Actual, company guidance, analyst consensus, internal estimate, scenario, and market observation are different value classes.",
    "Every populated observation must preserve an as-of date, reporting period, unit, source tier, and source URL.",
    "Missing values remain missing. Peer medians and model outputs never overwrite reported values.",
    "Quarterly, annual, duration, instant, segment, consolidated, and point-in-time observations are not silently mixed.",
    "A derived metric must expose its formula and upstream observation identifiers.",
    "Qualitative NAND disclosures preserve the company wording; numeric intervals are versioned normalizations rather than exact reported point values."
  ],
  "value_types": [
    "actual",
    "company_guidance",
    "analyst_consensus",
    "internal_estimate",
    "scenario",
    "market_observation"
  ],
  "source_tiers": [
    "primary_regulatory",
    "primary_company",
    "licensed_consensus",
    "market_data",
    "model"
  ],
  "comparison_types": [
    "yoy",
    "qoq",
    "vs_company_guidance",
    "vs_analyst_consensus",
    "vs_prior_estimate",
    "vs_scenario",
    "peer_percentile"
  ],
  "concepts": [
    {"id":"revenue","statement":"income_statement","default_unit":"currency","aggregation":"sum_duration","status":"implemented"},
    {"id":"operating_income","statement":"income_statement","default_unit":"currency","aggregation":"sum_duration","status":"implemented"},
    {"id":"net_income","statement":"income_statement","default_unit":"currency","aggregation":"sum_duration","status":"catalogued"},
    {"id":"eps_diluted","statement":"income_statement","default_unit":"currency_per_share","aggregation":"duration_ratio","status":"catalogued"},
    {"id":"operating_cash_flow","statement":"cash_flow","default_unit":"currency","aggregation":"sum_duration","status":"implemented"},
    {"id":"capital_expenditures","statement":"cash_flow","default_unit":"currency","aggregation":"sum_duration","status":"implemented"},
    {"id":"depreciation_amortization","statement":"cash_flow","default_unit":"currency","aggregation":"sum_duration","status":"catalogued"},
    {"id":"stock_based_compensation","statement":"cash_flow","default_unit":"currency","aggregation":"sum_duration","status":"catalogued"},
    {"id":"cash","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"implemented"},
    {"id":"short_term_investments","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"implemented"},
    {"id":"total_debt","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"implemented_as_derived"},
    {"id":"retained_earnings","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"implemented"},
    {"id":"total_assets","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"current_assets","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"current_liabilities","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"accounts_receivable","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"inventory","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"deferred_revenue","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"lease_liabilities","statement":"balance_sheet","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"free_cash_flow","statement":"derived","default_unit":"currency","aggregation":"formula","formula":"operating_cash_flow - abs(capital_expenditures)","status":"implemented"},
    {"id":"free_cash_flow_margin","statement":"derived","default_unit":"ratio","aggregation":"formula","formula":"free_cash_flow / revenue","status":"implemented"},
    {"id":"operating_margin","statement":"derived","default_unit":"ratio","aggregation":"formula","formula":"operating_income / revenue","status":"implemented"},
    {"id":"revenue_yoy","statement":"derived","default_unit":"ratio","aggregation":"formula","formula":"latest_comparable_revenue / prior_year_comparable_revenue - 1","status":"implemented"},
    {"id":"net_liquidity","statement":"derived","default_unit":"currency","aggregation":"formula","formula":"cash + short_term_investments - total_debt","status":"implemented"},
    {"id":"capex_intensity","statement":"derived","default_unit":"ratio","aggregation":"formula","formula":"abs(capital_expenditures) / revenue","status":"implemented"},
    {"id":"cloud_revenue","statement":"segment_kpi","default_unit":"currency","aggregation":"sum_duration","status":"catalogued"},
    {"id":"cloud_growth","statement":"segment_kpi","default_unit":"ratio","aggregation":"reported_or_formula","status":"catalogued"},
    {"id":"remaining_performance_obligations","statement":"segment_kpi","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"backlog","statement":"segment_kpi","default_unit":"currency","aggregation":"instant","status":"catalogued"},
    {"id":"bookings","statement":"segment_kpi","default_unit":"currency","aggregation":"sum_duration","status":"catalogued"},
    {"id":"data_center_capex","statement":"segment_kpi","default_unit":"currency","aggregation":"sum_duration","status":"catalogued"},
    {"id":"capex_guidance","statement":"guidance","default_unit":"currency","aggregation":"range_or_point","status":"catalogued"},
    {"id":"depreciation_guidance","statement":"guidance","default_unit":"currency","aggregation":"range_or_point","status":"catalogued"},
    {"id":"energy_capacity_mw","statement":"operating_kpi","default_unit":"MW","aggregation":"instant_or_pipeline","status":"catalogued"},
    {"id":"memory_asp_change","statement":"operating_kpi","default_unit":"ratio","aggregation":"duration_change","status":"catalogued"},
    {"id":"bit_shipments_change","statement":"operating_kpi","default_unit":"ratio","aggregation":"duration_change","status":"catalogued"},
    {"id":"nand_asp_change_qoq","statement":"operating_kpi","default_unit":"ratio","aggregation":"reported_interval","status":"implemented"},
    {"id":"nand_asp_change_yoy","statement":"derived","default_unit":"ratio","aggregation":"formula","formula":"product(1 + four consecutive nand_asp_change_qoq intervals) - 1","status":"implemented"},
    {"id":"nand_asp_vs_company_guidance","statement":"derived","default_unit":"percentage_points","aggregation":"formula","formula":"actual NAND ASP interval - comparable company-guidance interval","status":"implemented"},
    {"id":"nand_bit_shipments_change_qoq","statement":"operating_kpi","default_unit":"ratio","aggregation":"reported_interval","status":"implemented"},
    {"id":"nand_bit_shipments_change_yoy","statement":"derived","default_unit":"ratio","aggregation":"formula","formula":"product(1 + four consecutive nand_bit_shipments_change_qoq intervals) - 1","status":"implemented"},
    {"id":"nand_bit_shipments_vs_company_guidance","statement":"derived","default_unit":"percentage_points","aggregation":"formula","formula":"actual NAND bit-shipment interval - comparable company-guidance interval","status":"implemented"},
    {"id":"inventory_days","statement":"operating_kpi","default_unit":"days","aggregation":"formula_or_reported","status":"catalogued"},
    {"id":"fab_utilization","statement":"operating_kpi","default_unit":"ratio","aggregation":"period_average","status":"catalogued"},
    {"id":"wafer_capacity","statement":"operating_kpi","default_unit":"wafers_per_month","aggregation":"instant","status":"catalogued"},
    {"id":"hbm_revenue","statement":"operating_kpi","default_unit":"currency","aggregation":"sum_duration","status":"catalogued"},
    {"id":"hbm_capacity","statement":"operating_kpi","default_unit":"capacity_index","aggregation":"instant_or_guidance","status":"catalogued"},
    {"id":"advanced_packaging_capacity","statement":"operating_kpi","default_unit":"wafers_per_month","aggregation":"instant_or_guidance","status":"catalogued"},
    {"id":"share_price","statement":"market","default_unit":"currency_per_share","aggregation":"point_in_time","status":"catalogued"},
    {"id":"market_cap","statement":"market","default_unit":"currency","aggregation":"point_in_time","status":"catalogued"},
    {"id":"enterprise_value","statement":"market","default_unit":"currency","aggregation":"point_in_time","status":"catalogued"},
    {"id":"forward_pe","statement":"market","default_unit":"multiple","aggregation":"point_in_time","status":"catalogued"},
    {"id":"consensus_revenue","statement":"consensus","default_unit":"currency","aggregation":"point_estimate","status":"catalogued"},
    {"id":"consensus_eps","statement":"consensus","default_unit":"currency_per_share","aggregation":"point_estimate","status":"catalogued"}
  ]
}
