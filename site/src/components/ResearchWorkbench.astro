---
import fs from 'node:fs';
import path from 'node:path';
import { classifyCanonicalChange } from '../lib/activity-change.mjs';

const { view = 'projects' } = Astro.props;
const cwd = process.cwd();
const root = cwd.endsWith('site') ? path.resolve(cwd, '..') : cwd;
const read = (p) => JSON.parse(fs.readFileSync(path.join(root, p), 'utf8'));
const readOptional = (p, fallback) => {
  const file = path.join(root, p);
  return fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : fallback;
};
const base = import.meta.env.BASE_URL;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA || 'local';

const entitiesDoc = read('site/public/api/v2/entities/index.json');
const projectsDoc = read('site/public/api/v2/projects/index.json');
const eventsDoc = read('site/public/api/v2/events/index.json');
const facilitiesDoc = read('site/public/api/v2/facilities/index.json');
const commitmentsDoc = read('site/public/api/v2/customer-commitments/index.json');
const backlogDoc = read('site/public/api/v2/orders-backlog/index.json');
const factsDoc = read('site/public/api/v2/facts/index.json');
const financialDoc = readOptional('site/public/api/v3/financial-database/index.json', {entities:[],views:{latest_actuals:[]},audit:{counts:{}}});

const entities = entitiesDoc.entities || [];
const projects = projectsDoc.projects || [];
const events = eventsDoc.events || [];
const facilities = facilitiesDoc.facilities || [];
const commitments = commitmentsDoc.commitments || [];
const backlog = backlogDoc.backlog || [];
const facts = factsDoc.facts || [];
const financialEntities = financialDoc.entities || [];
const financialObservations = financialDoc.observations || [];
const financialEntityMap = new Map(financialEntities.map((e) => [e.id, e]));
const financialHistoryMap = new Map();
for (const o of financialObservations) {
  if (o.value_type !== 'actual' || o.value == null) continue;
  const key = String(o.entity_id) + '|' + String(o.concept_id);
  if (!financialHistoryMap.has(key)) financialHistoryMap.set(key, []);
  financialHistoryMap.get(key).push({
    id:o.id, period_end:o.period_end || o.as_of || '', value:o.value, unit:o.unit,
    source_url:o.source_url, source_tier:o.source_tier, value_type:o.value_type,
  });
}
for (const series of financialHistoryMap.values()) series.sort((a,b)=>String(a.period_end).localeCompare(String(b.period_end)));
const entityMap = new Map(entities.map((e) => [e.entity_id || e.id, e]));
const prov = (row) => row?.provenance?.[0] || {};
const capexAmount = (project) => project.capex_plan || project.capex_actual || null;
const qualityLabel = (q) => q === 'primary_source_extracted' ? 'Primary' : q === 'imported_unverified' ? 'Imported' : (q || 'Unknown');

const projectRows = projects.map((p) => {
  const e = entityMap.get(p.entity_id) || {};
  const pv = prov(p);
  return {
    id: p.project_id, type: 'project', entity_id: p.entity_id,
    company: e.company_name || e.name || p.entity_id,
    ticker: e.security_code || e.ticker || p.entity_id,
    role: e.role || '', country: e.country || '',
    project_name: p.project_name, product: p.product, technology: p.technology,
    location: p.location, status: p.status, event_type: p.event_type,
    capex: capexAmount(p), currency: p.currency,
    capacity_before: p.capacity_before, capacity_after: p.capacity_after,
    capacity_metric: p.capacity_metric, capacity_unit: p.capacity_unit,
    target_date: p.period_end || p.planned_start || p.production_start,
    period_end: p.period_end, production_start: p.production_start,
    demand_evidence: p.demand_evidence, customer_commitment: p.customer_commitment,
    quality: p.quality_flag, quality_label: qualityLabel(p.quality_flag),
    source_system: p.source_system, source_url: p.source_url, source_doc_id: p.source_doc_id,
    import_source: pv.import_source, import_record_id: pv.import_record_id, imported_at: pv.imported_at,
    raw: p,
  };
});

const projectByEntity = new Map();
for (const row of projectRows) {
  if (!projectByEntity.has(row.entity_id)) projectByEntity.set(row.entity_id, []);
  projectByEntity.get(row.entity_id).push(row);
}

const companyRows = entities.map((e) => {
  const id = e.entity_id || e.id;
  const ps = projectByEntity.get(id) || [];
  const primary = ps.filter((p) => p.quality === 'primary_source_extracted').length;
  const capacity = ps.filter((p) => p.capacity_before != null || p.capacity_after != null).length;
  const pv = prov(e);
  return {
    id, type: 'company', entity_id: id,
    company: e.company_name || e.name || id, name: e.company_name || e.name || id,
    ticker: e.security_code || e.ticker || id, role: e.role || '', country: e.country || '',
    status: ps.length ? 'Tracked' : 'No canonical projects',
    project_count: ps.length, capacity_projects: capacity, primary_evidence: primary,
    quality: primary ? 'primary_source_extracted' : (pv.import_source ? 'imported_unverified' : ''),
    quality_label: primary ? 'Primary' : (pv.import_source ? 'Imported' : 'Unknown'),
    source_system: pv.import_source || '', source_url: pv.original_source_url || e.index_membership?.[0]?.source_url || null,
    source_doc_id: pv.doc_id || null, import_source: pv.import_source,
    import_record_id: pv.import_record_id, imported_at: pv.imported_at, raw: e,
  };
});

const capacityRows = projectRows.filter((r) => r.capacity_before != null || r.capacity_after != null || r.capacity_metric);
const evidenceRows = events.map((ev) => {
  const e = entityMap.get(ev.entity_id) || {};
  const pv = prov(ev);
  return {
    id: ev.event_id, type: 'evidence', entity_id: ev.entity_id,
    company: e.company_name || e.name || ev.entity_id, ticker: e.security_code || e.ticker || ev.entity_id,
    role: e.role || '', country: e.country || '', project_name: ev.project_name,
    status: ev.status, event_type: ev.event_type, target_date: ev.period_end || ev.announcement_date,
    evidence: ev.evidence_text, quality: ev.quality_flag, quality_label: qualityLabel(ev.quality_flag),
    source_system: ev.source_system, source_url: ev.source_url, source_doc_id: ev.source_doc_id,
    import_source: pv.import_source, import_record_id: pv.import_record_id, imported_at: pv.imported_at, raw: ev,
  };
});

const facilityRows = facilities.map((f) => {
  const e = entityMap.get(f.entity_id) || {};
  const pv = prov(f);
  return {
    id: f.facility_id, type: 'facility', entity_id: f.entity_id,
    company: e.company_name || e.name || f.entity_id, ticker: e.security_code || e.ticker || f.entity_id,
    role: e.role || '', country: f.country || e.country || '', project_name: f.facility_name,
    location: f.location, status: 'Facility', target_date: f.fiscal_year ? String(f.fiscal_year) : '',
    land_area_m2: f.land_area_m2, quality: f.quality_flag, quality_label: qualityLabel(f.quality_flag),
    source_system: f.source_system, source_url: f.source_url, source_doc_id: f.source_doc_id,
    import_source: pv.import_source, imported_at: pv.imported_at, raw: f,
  };
});

const financialRows = (financialDoc.views?.latest_actuals || []).map((o) => {
  const e = financialEntityMap.get(o.entity_id) || {};
  return {
    id: o.id, type: 'financial', entity_id: o.entity_id,
    company: e.name || e.company_name || o.entity_id, name: e.name || e.company_name || o.entity_id,
    ticker: e.ticker || e.stock_code || o.entity_id, role: e.role || '', country: e.country || '',
    concept_id: o.concept_id, value: o.value ?? o.value_low ?? o.value_high ?? null, unit: o.unit,
    value_type: o.value_type, status: o.value_type, target_date: o.period_end || o.as_of,
    period_end: o.period_end, source_system: o.source_tier, source_url: o.source_url,
    source_doc_id: o.id, quality: o.source_tier === 'primary_regulatory' || o.source_tier === 'primary_company' ? 'primary_source_extracted' : o.source_tier,
    quality_label: o.source_tier || 'Unknown', evidence: o.reported_text || '',
    history: (financialHistoryMap.get(String(o.entity_id) + '|' + String(o.concept_id)) || []).slice(-12),
    raw: o,
  };
});
const activityRows = evidenceRows.map(row => ({...row,change_type:classifyCanonicalChange(row)}))
  .sort((a,b) => String(b.target_date || '').localeCompare(String(a.target_date || '')) || String(b.imported_at || '').localeCompare(String(a.imported_at || '')));
const qualityRows = [...projectRows, ...evidenceRows, ...facilityRows].sort((a,b) => String(a.quality || '').localeCompare(String(b.quality || '')));
const columns = {
  projects: [
    {key:'select',label:'',width:34},{key:'company',label:'Company'},{key:'project_name',label:'Project'},
    {key:'capex',label:'CapEx',numeric:true},{key:'capacity',label:'Capacity',numeric:true},
    {key:'status',label:'Status'},{key:'target_date',label:'Target'},{key:'country',label:'Country'},{key:'quality',label:'Evidence'},
  ],
  companies: [
    {key:'select',label:'',width:34},{key:'company',label:'Company'},{key:'role',label:'Role'},{key:'country',label:'Country'},
    {key:'project_count',label:'Projects',numeric:true},{key:'capacity_projects',label:'Capacity Projects',numeric:true},
    {key:'primary_evidence',label:'Primary Evidence',numeric:true},{key:'status',label:'Coverage'},{key:'quality',label:'Evidence'},
  ],
  capacity: [
    {key:'select',label:'',width:34},{key:'company',label:'Company'},{key:'project_name',label:'Project'},
    {key:'capacity_metric',label:'Metric'},{key:'capacity',label:'Before → After',numeric:true},
    {key:'capacity_unit',label:'Unit / Definition'},{key:'target_date',label:'Target'},{key:'status',label:'Status'},{key:'quality',label:'Evidence'},
  ],
  evidence: [
    {key:'select',label:'',width:34},{key:'company',label:'Company'},{key:'project_name',label:'Event / Project'},
    {key:'event_type',label:'Type'},{key:'status',label:'Status'},{key:'target_date',label:'Date'},
    {key:'source_system',label:'Source'},{key:'quality',label:'Quality'},
  ],
  activity: [
    {key:'select',label:'',width:34},{key:'target_date',label:'Date'},{key:'change_type',label:'Canonical Change'},{key:'company',label:'Company'},
    {key:'project_name',label:'Event / Project'},{key:'event_type',label:'Type'},{key:'status',label:'Status'},
    {key:'source_system',label:'Source'},{key:'quality',label:'Quality'},
  ],
  quality: [
    {key:'select',label:'',width:34},{key:'company',label:'Company'},{key:'project_name',label:'Record'},
    {key:'type',label:'Record Type'},{key:'quality',label:'Quality'},{key:'source_system',label:'Source'},
    {key:'status',label:'Status'},{key:'target_date',label:'Date'},
  ],
  facilities: [
    {key:'select',label:'',width:34},{key:'company',label:'Company'},{key:'project_name',label:'Facility'},
    {key:'country',label:'Country'},{key:'location',label:'Location'},{key:'land_area_m2',label:'Land m²',numeric:true},
    {key:'target_date',label:'FY'},{key:'quality',label:'Evidence'},
  ],
  financials: [
    {key:'select',label:'',width:34},{key:'company',label:'Company'},{key:'concept_id',label:'Metric'},
    {key:'value',label:'Value',numeric:true},{key:'unit',label:'Unit'},{key:'value_type',label:'Value Type'},
    {key:'target_date',label:'Period'},{key:'source_system',label:'Source Tier'},{key:'quality',label:'Evidence'},
  ],
};
const rowsByView = {projects:projectRows,companies:companyRows,financials:financialRows,capacity:capacityRows,facilities:facilityRows,activity:activityRows,evidence:evidenceRows,quality:qualityRows};
const normalizedView = rowsByView[view] ? view : 'projects';
const rows = rowsByView[normalizedView];
const activeColumns = columns[normalizedView];
const summary = {entities:entities.length,projects:projects.length,facilities:facilities.length,commitments:commitments.length,backlog:backlog.length,facts:facts.length};
const titles = {
  projects:['Projects','CapEx / capacity projects with source-level evidence'],
  companies:['Companies','Canonical entity universe and evidence coverage'],
  capacity:['Capacity','Physical capacity claims only. Allocation and utilization are not treated as expansion.'],
  activity:['Activity','Canonical change semantics over source-traceable disclosures, newest first.'],
  evidence:['Evidence','Events and disclosures, with provenance one click away'],
  quality:['Data Quality','Primary, imported, missing and conflicting records'],
  facilities:['Facilities','Canonical production / R&D / expansion locations'],
  financials:['Financials','Latest source-traceable observations. Actual, guidance and derived values remain separate.'],
};
const [title, subtitle] = titles[normalizedView];
const safeJson = (value) => JSON.stringify(value).replaceAll('<','\\u003c').replaceAll('>','\\u003e').replaceAll('&','\\u0026');
const apiPaths = {
  projects:'api/v2/projects/index.json', companies:'api/v2/entities/index.json',
  financials:'api/v3/financial-database/index.json', capacity:'api/v2/projects/index.json',
  facilities:'api/v2/facilities/index.json', activity:'api/v2/events/index.json',
  evidence:'api/v2/events/index.json', quality:'api/v2/projects/index.json',
};
const defaultSortByView = {activity:'target_date',quality:'quality'};
const defaultDirByView = {activity:'desc',quality:'asc'};
const financialByEntity = new Map();
for (const row of financialRows) {
  if (!financialByEntity.has(row.entity_id)) financialByEntity.set(row.entity_id, []);
  financialByEntity.get(row.entity_id).push(row);
}
const evidenceByEntity = new Map();
for (const row of evidenceRows) {
  if (!evidenceByEntity.has(row.entity_id)) evidenceByEntity.set(row.entity_id, []);
  evidenceByEntity.get(row.entity_id).push(row);
}
const activityByEntity = new Map();
for (const row of activityRows) {
  if (!activityByEntity.has(row.entity_id)) activityByEntity.set(row.entity_id, []);
  activityByEntity.get(row.entity_id).push(row);
}
const facilityByEntity = new Map();
for (const row of facilityRows) {
  if (!facilityByEntity.has(row.entity_id)) facilityByEntity.set(row.entity_id, []);
  facilityByEntity.get(row.entity_id).push(row);
}
const commitmentsByEntity = new Map();
for (const row of commitments) {
  if (!commitmentsByEntity.has(row.entity_id)) commitmentsByEntity.set(row.entity_id, []);
  commitmentsByEntity.get(row.entity_id).push(row);
}
const compactLinked = (row, kind) => {
  if (kind === 'projects') return {id:row.id,project_name:row.project_name,status:row.status,target_date:row.target_date,source_url:row.source_url};
  if (kind === 'evidence') return {id:row.id,project_name:row.project_name,event_type:row.event_type,status:row.status,target_date:row.target_date,source_url:row.source_url,source_system:row.source_system};
  if (kind === 'activity') return {id:row.id,project_name:row.project_name,change_type:row.change_type,event_type:row.event_type,status:row.status,target_date:row.target_date,source_url:row.source_url};
  if (kind === 'facilities') return {id:row.id,facility_name:row.project_name,location:row.location,target_date:row.target_date,source_url:row.source_url};
  if (kind === 'financials') return {id:row.id,concept_id:row.concept_id,value:row.value,unit:row.unit,target_date:row.target_date,source_url:row.source_url};
  if (kind === 'commitments') return {id:row.commitment_id,customer_name:row.customer_name,commitment_type:row.commitment_type,status:row.contract_status,period_end:row.period_end};
  return {id:row.id};
};
const linkedByEntity = Object.fromEntries(entities.map((e) => {
  const id = e.entity_id || e.id;
  return [id, {
    projects:(projectByEntity.get(id) || []).slice(0,12).map(row=>compactLinked(row,'projects')),
    evidence:(evidenceByEntity.get(id) || []).slice(0,12).map(row=>compactLinked(row,'evidence')),
    activity:(activityByEntity.get(id) || []).slice(0,12).map(row=>compactLinked(row,'activity')),
    facilities:(facilityByEntity.get(id) || []).slice(0,12).map(row=>compactLinked(row,'facilities')),
    financials:(financialByEntity.get(id) || []).slice(0,24).map(row=>compactLinked(row,'financials')),
    commitments:(commitmentsByEntity.get(id) || []).slice(0,12).map(row=>compactLinked(row,'commitments')),
  }];
}));
const payload = {
  view:normalizedView, rows, columns:activeColumns,
  defaultSort:defaultSortByView[normalizedView] || 'company',
  defaultDir:defaultDirByView[normalizedView] || 'asc',
  base, apiUrl:base + apiPaths[normalizedView],
  linkedByEntity,
  exportMeta:{
    schema_version:'semiconductor-workbench-export.v1',
    view:normalizedView,
    generated_from:apiPaths[normalizedView],
    build_sha:buildSha,
    semantics:['NULL != 0','Actual != Guidance','Derived != Observed'],
  },
};
const nav = [['projects','▦','Projects'],['companies','◫','Companies'],['financials','≡','Financials'],['capacity','↗','Capacity'],['facilities','⌖','Facilities'],['activity','↻','Activity'],['evidence','◎','Evidence'],['quality','!','Quality']];
const hrefFor = (key) => key === 'projects' ? base : base + key + '/';
---

<link rel="stylesheet" href={base + 'assets/bi-workbench.css'} />
<div class="wb-shell" data-workbench data-view={normalizedView} data-build-sha={buildSha}>
  <aside class="wb-rail" aria-label="Workbench navigation">
    <a class="wb-brand" href={base}><span>SEMICON LEDGER<small>RESEARCH WORKBENCH</small></span></a>
    <nav class="wb-nav">
      {nav.map(([key,icon,label]) => (
        <a href={hrefFor(key)} aria-current={normalizedView === key ? 'page' : undefined}>
          <span class="ico">{icon}</span><span class="label">{label}</span>
        </a>
      ))}
    </nav>
    <div class="wb-rail-foot">Canonical v2<br />NULL ≠ 0<br />Actual ≠ Guidance</div>
  </aside>

  <main class="wb-main">
    <header class="wb-topbar">
      <button class="wb-top-action wb-mobile-menu" type="button" data-open-mobile-nav aria-label="Open navigation">Menu</button>
      <div class="wb-search">
        <span aria-hidden="true">⌕</span>
        <input data-search type="search" placeholder="Search company, ticker, project, technology…" aria-label="Search workbench" />
        <span class="wb-kbd">/</span>
      </div>
      <button class="wb-top-action desktop-only" type="button" data-open-command>Command <span class="wb-kbd">⌘K</span></button>
      <button class="wb-top-action desktop-only" type="button" data-open-views>Views</button>
      <button class="wb-top-action desktop-only" type="button" data-open-workspaces>Workspaces</button>
      <button class="wb-top-action desktop-only" type="button" data-save-workspace>Save workspace</button>
      <button class="wb-top-action" type="button" data-copy-view>Share</button>
      <a class="wb-top-action" href={base + apiPaths[normalizedView]} target="_blank" rel="noreferrer">API</a>
      <button class="wb-top-action" type="button" data-open-export>Export</button>
    </header>

    <section class="wb-context" aria-labelledby="wb-title">
      <div class="wb-title"><h1 id="wb-title">{title}</h1><p>{subtitle}</p></div>
      <div class="wb-summary" aria-label="Canonical coverage">
        <span><b>{summary.entities}</b> entities</span><span><b>{summary.projects}</b> projects</span>
        <span><b>{summary.facilities}</b> facilities</span><span><b>{summary.commitments}</b> commitments</span><span><b>{summary.facts}</b> facts</span>
      </div>
    </section>

    <section class="wb-controls" aria-label="Screener controls">
      <span class="wb-view-label">Screen</span>
      <select class="wb-filter" data-filter="country" aria-label="Filter by country"><option value="">All countries</option></select>
      <select class="wb-filter" data-filter="role" aria-label="Filter by role"><option value="">All roles</option></select>
      <select class="wb-filter" data-filter="status" aria-label="Filter by status"><option value="">All status</option></select>
      <select class="wb-filter" data-filter="quality" aria-label="Filter by evidence quality"><option value="">All evidence</option></select>
      <button class="wb-control-btn" type="button" data-clear-filters>Clear</button>
      <button class="wb-control-btn" type="button" data-open-columns>Columns</button>
      <button class="wb-control-btn" type="button" data-watchlist-filter>Watchlist <span data-watchlist-count>0</span></button>
      <div class="wb-filter-chips" data-cross-filter-chips aria-label="Active cross filters"></div>
      <span class="wb-spacer"></span><span class="wb-view-label"><strong data-result-count>{rows.length}</strong> rows</span>
    </section>

    <section class="wb-linked-strip" data-linked-strip aria-label="Linked active context" hidden></section>
    <section class="wb-chart-panel" data-chart-panel aria-label="Interactive chart"></section>
    <section class="wb-linked-panels" data-linked-panels aria-label="Linked research panels" hidden></section>

    <div class="wb-workspace" data-workspace>
      <section class="wb-grid-panel" aria-label={title + ' data grid'}>
        <div class="wb-table-wrap">
          <table class="wb-table">
            <thead>
              <tr>{activeColumns.map((col) => (
                <th class={col.numeric ? 'num' : ''} data-col={col.key} data-sort={col.key === 'select' ? undefined : col.key} aria-sort={col.key === 'select' ? undefined : 'none'} style={col.width ? 'width:' + col.width + 'px' : undefined}>{col.label}</th>
              ))}</tr>
              <tr class="wb-column-filter-row" data-column-filter-row>{activeColumns.map((col) => (
                <th data-filter-col={col.key}>{col.key === 'select' ? '' : <input type="search" data-column-filter={col.key} aria-label={'Filter ' + col.label} placeholder="filter…" />}</th>
              ))}</tr>
            </thead>
            <tbody data-table-body></tbody>
          </table>
        </div>
      </section>
      <aside class="wb-inspector" data-inspector aria-label="Record inspector"></aside>
    </div>
  </main>

  <div class="wb-bottom" data-compare-bar aria-live="polite">
    <div class="wb-bottom-inner"><strong><span data-compare-count>0</span> selected</strong>
      <button type="button" data-open-compare>Compare</button><button type="button" data-add-watchlist>Add to watchlist</button><button type="button" data-export-selected>Export selected</button><button type="button" data-copy-view>Copy view URL</button><button type="button" data-clear-selection>Clear selection</button>
    </div>
  </div>

  <dialog class="wb-mobile-nav" data-mobile-nav-dialog>
    <div class="wb-mobile-nav-head"><strong>Research Workbench</strong><button class="wb-close" type="button" data-close-mobile-nav aria-label="Close navigation">×</button></div>
    <nav aria-label="Mobile workbench navigation">
      {nav.map(([key,icon,label]) => (
        <a href={hrefFor(key)} aria-current={normalizedView === key ? 'page' : undefined}><span class="ico">{icon}</span><span>{label}</span></a>
      ))}
    </nav>
  </dialog>
  <dialog class="wb-command" data-command>
    <input data-command-input type="search" placeholder="Search entity / project / ticker…" aria-label="Command palette search" />
    <div class="wb-command-results" data-command-results></div>
  </dialog>
  <dialog class="wb-modal" data-column-dialog>
    <div class="wb-modal-head"><h2>Column set</h2><button class="wb-close" type="button" data-close-columns aria-label="Close columns">×</button></div>
    <div class="wb-modal-body"><div class="wb-column-list" data-column-list></div></div>
  </dialog>
  <dialog class="wb-modal" data-compare-dialog>
    <div class="wb-modal-head"><h2>Compare selected</h2><button class="wb-close" type="button" data-close-compare aria-label="Close comparison">×</button></div>
    <div class="wb-modal-body" data-compare-body></div>
  </dialog>
  <dialog class="wb-modal" data-views-dialog>
    <div class="wb-modal-head"><h2>Saved views</h2><button class="wb-close" type="button" data-close-views aria-label="Close saved views">×</button></div>
    <div class="wb-modal-body" data-views-body></div>
  </dialog>
  <dialog class="wb-modal" data-workspace-dialog>
    <div class="wb-modal-head"><h2>Saved workspaces</h2><button class="wb-close" type="button" data-close-workspaces aria-label="Close workspaces">×</button></div>
    <div class="wb-modal-body">
      <div class="wb-workspace-controls">
        <label><input type="checkbox" data-widget-visible="chart" checked /> Chart</label>
        <label><input type="checkbox" data-widget-visible="linked" checked /> Linked context</label>
        <label>Layout <select data-widget-layout><option value="default">Default</option><option value="grid-focus">Grid focus</option><option value="chart-focus">Chart focus</option></select></label>
        <label>Chart height <select data-widget-size="chartHeight"><option value="150">150</option><option value="170">170</option><option value="220">220</option><option value="300">300</option></select></label>
        <label>Inspector width <select data-widget-size="inspectorWidth"><option value="320">320</option><option value="360">360</option><option value="390">390</option><option value="440">440</option></select></label>
      </div>
      <div data-workspace-list></div>
    </div>
  </dialog>
  <dialog class="wb-modal" data-export-dialog>
    <div class="wb-modal-head"><h2>Export reproducible slice</h2><button class="wb-close" type="button" data-close-export aria-label="Close export">×</button></div>
    <div class="wb-modal-body">
      <div class="wb-export-grid">
        <button type="button" data-export-visible><strong>Displayed CSV</strong><small>Current filters, sort and visible columns</small></button>
        <button type="button" data-export-selected><strong>Selected CSV</strong><small>Only selected rows and visible columns</small></button>
        <button type="button" data-export-json><strong>Displayed JSON</strong><small>Current filtered records with canonical fields</small></button>
        <button type="button" data-export-full><strong>Full canonical JSON</strong><small>All records in the canonical slice behind this view</small></button>
        <button type="button" data-export-meta><strong>Metadata JSON</strong><small>View schema, source API and semantic contract</small></button>
        <button type="button" data-copy-api><strong>Copy API URL</strong><small>Canonical source endpoint for this view</small></button>
      </div>
    </div>
  </dialog>
  <script type="application/json" id="workbench-data" set:html={safeJson(payload)}></script>
  <script src={base + 'assets/workspace-state.js'} defer></script>
  <script src={base + 'assets/chart-engine.js'} defer></script>
  <script src={base + 'assets/workbench-data-engine.js'} defer></script>
  <script src={base + 'assets/bi-workbench.js'} defer></script>
</div>
