---
import fs from 'node:fs';
import path from 'node:path';

const root = process.cwd().endsWith('site') ? path.resolve(process.cwd(), '..') : process.cwd();
const revenuePath = path.join(root, 'data/earnings_ledger/verified_revenue_latest.json');
const lineagePath = path.join(root, 'data/earnings_ledger/verified_revenue_lineage_audit_latest.json');
const publicationPath = path.join(root, 'data/earnings_ledger/publication_latest.json');
const revenue = JSON.parse(fs.readFileSync(revenuePath, 'utf8'));
const lineage = JSON.parse(fs.readFileSync(lineagePath, 'utf8'));
const publication = JSON.parse(fs.readFileSync(publicationPath, 'utf8'));

if (revenue.status !== 'PASS' || revenue.issues?.length) {
  throw new Error('Verified revenue artifact is not publishable');
}
if (lineage.status !== 'PASS' || lineage.issues?.length) {
  throw new Error('Verified revenue lineage audit is not publishable');
}
if (lineage.checked_metrics_total !== revenue.verified_metrics_total) {
  throw new Error('Verified revenue and lineage counts differ');
}
if (publication.schema_version !== 'earnings-ledger-publication.v1' || publication.audit_status !== 'PASS') {
  throw new Error('Earnings publication artifact is not publishable');
}
if (
  publication.contract?.primary_sources_only !== true ||
  publication.contract?.freshness_gate_hours !== 24 ||
  publication.contract?.publication_rechecks_freshness !== true ||
  publication.contract?.fail_closed !== true ||
  publication.contract?.unverified_values_published !== false
) {
  throw new Error('Earnings publication safety contract is incomplete');
}
if (!Array.isArray(publication.events) || publication.accepted_events_total !== publication.events.length) {
  throw new Error('Earnings publication event count is inconsistent');
}
if (
  !Number.isInteger(publication.ledger_accepted_events_total) ||
  !Number.isInteger(publication.expired_events_total) ||
  publication.ledger_accepted_events_total !== publication.accepted_events_total + publication.expired_events_total
) {
  throw new Error('Earnings publication freshness accounting is inconsistent');
}

const publishableEventIds = new Set(
  publication.events.map((event) => {
    if (!event?.event_id) throw new Error('Published earnings event is missing event_id');
    return event.event_id;
  }),
);
const rawMetrics = revenue.metrics || [];
const metrics = rawMetrics.filter((metric) => publishableEventIds.has(metric.event_id));
const hiddenByFreshness = rawMetrics.length - metrics.length;
const disabledSources = publication.unsupported_or_disabled_sources || [];

const base = import.meta.env.BASE_URL;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
if (!buildSha) throw new Error('PUBLIC_BUILD_SHA is required for provenance');

const usd = (value) => `$${(Number(value) / 1_000_000_000).toFixed(3)}B`;
const dateJP = (value) => {
  const [year, month, day] = String(value).slice(0, 10).split('-').map(Number);
  return `${year}年${month}月${day}日`;
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="24時間鮮度ゲートと一次情報監査を通過した決算指標だけを表示する監査済み決算台帳。" />
    <title>監査済み決算台帳 / Verified Earnings Ledger</title>
    <link rel="stylesheet" href={base + 'assets/aux-workbench.css'} />
</head>
  <body data-workbench data-aux-workbench
    data-build-sha={buildSha}
    data-ledger-status={revenue.status}
    data-lineage-status={lineage.status}
    data-publication-status={publication.audit_status}
    data-fresh-event-count={publication.accepted_events_total}
    data-expired-event-count={publication.expired_events_total}
    data-visible-metric-count={metrics.length}
    data-hidden-by-freshness-count={hiddenByFreshness}
  >
    <main>
      <header class="topbar">
        <a class="brand" href={base}>Financial Research Workbench</a>
        <nav aria-label="主要ページ">
          <a href={`${base}earnings/`}>Earnings</a>
          <a href={`${base}ledger/`} aria-current="page">Ledger</a>
          <a href={`${base}model/`}>Model</a>
        </nav>
      </header>

      <section class="hero">
        <div>
          <p class="eyebrow">PRIMARY SOURCE × LIVE 24H FRESHNESS × FAIL-CLOSED</p>
          <h1>確認できた数字だけを、<em>決算台帳に残す。</em></h1>
          <p class="lead">この画面は、一次情報・24時間鮮度・イベント同一性・データ系譜の監査をすべて通過し、公開時点でも24時間以内にある指標だけを表示します。未確認値、推測値、監査失敗値は表示しません。期限切れ値も公開画面には残しません。</p>
        </div>
        <aside>
          <span>PUBLICATION STATUS</span>
          <strong>{publication.audit_status}</strong>
          <dl>
            <div><dt>24時間内イベント</dt><dd>{publication.accepted_events_total}</dd></div>
            <div><dt>期限切れイベント</dt><dd>{publication.expired_events_total}</dd></div>
            <div><dt>表示中の指標</dt><dd>{metrics.length}</dd></div>
            <div><dt>鮮度で非表示</dt><dd>{hiddenByFreshness}</dd></div>
          </dl>
        </aside>
      </section>

      <section class="section trust" aria-labelledby="trust-title">
        <div class="heading">
          <div><p>01 / LIVE PUBLICATION GATE</p><h2 id="trust-title">収集済みと、<br /><em>公開可能は別。</em></h2></div>
          <p>履歴台帳に残る監査済みイベントでも、公開時点で24時間を超えたものは画面から除外します。表示対象は公開APIのfresh event IDと一致する指標だけです。</p>
        </div>
        <dl class="trust-grid">
          <div><dt>履歴台帳 accepted</dt><dd>{publication.ledger_accepted_events_total}</dd></div>
          <div><dt>現在 fresh</dt><dd>{publication.accepted_events_total}</dd></div>
          <div><dt>現在 expired</dt><dd>{publication.expired_events_total}</dd></div>
          <div><dt>rejected</dt><dd>{publication.rejected_events_total}</dd></div>
        </dl>
        {disabledSources.length > 0 && (
          <div class="gap-box">
            <strong>FAIL-CLOSED SOURCE GAPS</strong>
            <p>安全に検証できないため公開対象にしないsource: {disabledSources.join(', ')}</p>
          </div>
        )}
      </section>

      <section class="section" aria-labelledby="verified-title">
        <div class="heading">
          <div><p>02 / VERIFIED METRICS</p><h2 id="verified-title">監査済みの、<br /><em>決算指標。</em></h2></div>
          <p>SEC Company Factsの標準us-gaap factを、同一accession・form・period end・USDで照合し、さらに公開時点の24時間鮮度ゲートを通過した値だけを掲載します。</p>
        </div>

        {metrics.length ? (
          <div class="cards">
            {metrics.map((metric) => (
              <article class="metric-card" data-event-id={metric.event_id}>
                <div class="metric-head"><span>{metric.ticker}</span><small>{metric.document_type}</small></div>
                <h3>{metric.metric === 'revenue' ? '売上高' : metric.metric}</h3>
                <strong>{metric.unit === 'USD' ? usd(metric.value) : `${metric.value} ${metric.unit}`}</strong>
                <dl>
                  <div><dt>対象期末</dt><dd>{dateJP(metric.period_end)}</dd></div>
                  <div><dt>Taxonomy</dt><dd>{metric.taxonomy}</dd></div>
                  <div><dt>Concept</dt><dd><code>{metric.concept}</code></dd></div>
                  <div><dt>Accession</dt><dd><code>{metric.accession_number}</code></dd></div>
                </dl>
                <a href={metric.source_url} rel="noreferrer">SEC一次情報を開く ↗</a>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">現在、公開時点の24時間鮮度ゲートまで満たす決算指標はありません。履歴値を古いまま表示することはしません。</p>
        )}
      </section>

      <section class="section boundary" aria-labelledby="boundary-title">
        <div class="heading"><div><p>03 / PUBLICATION BOUNDARY</p><h2 id="boundary-title">表示しないもの。</h2></div></div>
        <ul>
          <li>公開時点で24時間鮮度ゲートを通過していない決算</li>
          <li>一次情報と完全一致しない数値</li>
          <li>GAAP / non-GAAPの根拠が未確認の指標</li>
          <li>イベントと一次証拠へ系譜を辿れない指標</li>
          <li>コンセンサスや会社予想と混同された値</li>
        </ul>
      </section>

      <footer>
        <span>BUILD SHA</span><code>{buildSha}</code>
        <span>METRIC RUN</span><code>{revenue.run_at}</code>
        <span>PUBLICATION RUN</span><code>{publication.generated_from_run_at}</code>
      </footer>
    </main>
  </body>
</html>

