---
import fs from 'node:fs';
import path from 'node:path';

const root = process.cwd().endsWith('site') ? path.resolve(process.cwd(), '..') : process.cwd();
const legacyApi = JSON.parse(fs.readFileSync(path.join(root, 'site/public/api/v1/semiconductor-resilience/index.json'), 'utf8'));
const research = JSON.parse(fs.readFileSync(path.join(root, 'site/public/api/v2/semiconductor-research/index.json'), 'utf8'));
const ontologyFallback = JSON.parse(fs.readFileSync(path.join(root, 'data/ontology/financial_research_ontology.json'), 'utf8'));
const benchmarkFallback = JSON.parse(fs.readFileSync(path.join(root, 'data/benchmark/earnings_review_sites.json'), 'utf8'));
const ontology = research.ontology?.entity_types?.length ? research.ontology : ontologyFallback;
const benchmark = research.benchmark?.platforms?.length ? research.benchmark : benchmarkFallback;
const base = import.meta.env.BASE_URL;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
if (!buildSha) throw new Error('PUBLIC_BUILD_SHA is required for provenance');

const companies = research.companies || [];
const summary = research.summary || {};
const database = research.database || { entities: [], reported_facts: [], derived_metrics: [], evaluations: [], evidence_edges: [] };
const evaluationRules = Object.fromEntries((ontology.evaluation_rules || []).map((rule) => [rule.id, rule]));
const metricCatalog = Object.fromEntries((ontology.metric_catalog || []).map((metric) => [metric.id, metric]));
const classificationLabels = {
  resilient: '耐久・創出力あり',
  watch: '要監視',
  vulnerable: '脆弱',
  incomplete: 'データ不足',
};
const classificationDescriptions = {
  resilient: '深い下振れ後も自己資金で黒字、または主要判定が安定。',
  watch: 'ストレス時の資金消耗、基準FCF赤字、または純流動性に注意。',
  vulnerable: '深い下振れ時の流動性耐久が2年未満。',
  incomplete: '一次データ充足率が判定基準に未達。',
};
const evaluationLabels = { pass: 'PASS', fail: 'WATCH', unknown: 'UNKNOWN' };
const qualityFlagLabels = {
  annual_history_under_five_years: '年次履歴5年未満',
  short_term_investments_not_separately_reported: '短期運用資産の別掲なし',
  debt_unavailable: '負債fact未取得',
  alternative_capex_concept: '代替CapEx概念を採用',
  quarterly_profit_unavailable: '四半期利益未取得',
  prior_year_comparable_quarter_unavailable: '前年同期比較不可',
};
const usd = (value, digits = 1) => {
  if (value == null) return '未取得';
  const number = Number(value);
  const absolute = Math.abs(number);
  const sign = number < 0 ? '−' : '';
  if (absolute >= 1_000_000_000) return `${sign}$${(absolute / 1_000_000_000).toFixed(digits)}B`;
  if (absolute >= 1_000_000) return `${sign}$${(absolute / 1_000_000).toFixed(digits)}M`;
  return `${sign}$${absolute.toLocaleString('en-US')}`;
};
const percent = (value, digits = 1) => value == null ? '未取得' : `${Number(value) >= 0 ? '+' : ''}${(Number(value) * 100).toFixed(digits)}%`;
const plainPercent = (value, digits = 0) => value == null ? '未取得' : `${(Number(value) * 100).toFixed(digits)}%`;
const bps = (value) => value == null ? '未取得' : `${Number(value) >= 0 ? '+' : ''}${Number(value).toLocaleString('ja-JP')}bp`;
const dateJP = (value) => {
  if (!value) return '未取得';
  const [year, month, day] = value.slice(0, 10).split('-').map(Number);
  return `${year}年${month}月${day}日`;
};
const runway = (company, scenarioId = 'severe') => company.scenarios.find((scenario) => scenario.scenario_id === scenarioId);
const runwayLabel = (scenario) => !scenario ? '未取得' : scenario.annual_cash_burn_usd === 0 ? 'ストレス後もFCF黒字' : `${Number(scenario.liquid_reserve_runway_years).toFixed(1)}年`;
const peerPercentile = (company, metric) => company.peer_context?.[metric]?.peer_percentile;
const percentileLabel = (value) => value == null ? '比較不可' : `同業上位 ${Math.max(1, Math.round((1 - Number(value)) * 100))}%`;
const evaluationFor = (company, ruleId) => company.evaluations.find((evaluation) => evaluation.rule_id === ruleId);
const directionClass = (value) => value == null ? 'neutral' : Number(value) < 0 ? 'negative' : 'positive';
const latestPeriod = companies.length ? companies.map((company) => company.latest_annual_period).sort().at(-1) : null;
const benchmarkCategories = Object.entries(benchmark.platforms.reduce((result, platform) => {
  result[platform.category] = (result[platform.category] || 0) + 1;
  return result;
}, {}));
const roleLabels = { semiconductor: '半導体', 'semiconductor-equipment': '製造装置' };
const severeOrder = [...companies].sort((a, b) => {
  const left = runway(a);
  const right = runway(b);
  const bandOrder = { under_two_years: 0, two_to_five_years: 1, five_years_plus: 2, self_funding: 3 };
  return bandOrder[left?.runway_band] - bandOrder[right?.runway_band]
    || (left?.liquid_reserve_runway_years ?? 999) - (right?.liquid_reserve_runway_years ?? 999);
});
const overallMedians = {
  revenueYoy: (() => { const values = companies.map((company) => company.metrics.revenue_yoy).filter((value) => value != null).sort((a, b) => a - b); return values.length ? values[Math.floor(values.length / 2)] : null; })(),
  operatingMargin: (() => { const values = companies.map((company) => company.metrics.operating_margin).filter((value) => value != null).sort((a, b) => a - b); return values.length ? values[Math.floor(values.length / 2)] : null; })(),
  fcfMargin: (() => { const values = companies.map((company) => company.metrics.free_cash_flow_margin).filter((value) => value != null).sort((a, b) => a - b); return values.length ? values[Math.floor(values.length / 2)] : null; })(),
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SEC一次情報、四半期利益、年次流動性、同業比較、下振れシナリオ、データ品質、オントロジーを統合した半導体企業の決算研究ワークベンチ。" />
    <title>半導体決算リサーチ・ワークベンチ / SEC一次情報</title>
  </head>
  <body data-build-sha={buildSha} data-resilience-api-hash={legacyApi.content_hash} data-research-api-hash={research.content_hash}>
    <main class="workbench-page">
      <header class="topbar">
        <a class="brand" href={`${base}earnings/`}><span class="brand-mark">＋</span><span>決算の読み方 <small>/ RESEARCH WORKBENCH</small></span></a>
        <nav aria-label="ページ内ナビゲーション">
          <a href="#quality">品質</a><a href="#actuals">実績</a><a href="#peers">同業</a><a href="#ranking">下振れ</a><a href="#ontology">構造</a><a href="#benchmark">比較</a><a href={`${base}earnings/`}>決算台帳 ↗</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">SEC FACTS × PEER CONTEXT × EXPLAINABLE RULES</p>
          <h1>半導体企業は、<em>成長しながら下振れに耐えられるか。</em></h1>
          <p class="lead">四半期の売上・営業利益と、年次の流動性・FCF・負債を一つの分析面へ統合しました。データ品質、同業中央値、機械的シナリオ、判定規則、XBRL概念、根拠edgeまで逆引きできます。</p>
          <div class="hero-actions">
            <a class="button-primary" href="#peers">企業比較を始める ↓</a>
            <a class="button-secondary" href={`${base}api/v2/semiconductor-research/index.json`}>研究API v2 ↗</a>
          </div>
        </div>
        <aside class="hero-audit">
          <span>現在の研究面</span>
          <strong>{summary.company_count || companies.length}<small>社</small></strong>
          <p>実績・流動性・同業比較・耐久評価を一次情報から再構成。</p>
          <dl>
            <div><dt>報告fact</dt><dd>{summary.reported_fact_count || database.reported_facts.length}</dd></div>
            <div><dt>派生指標</dt><dd>{summary.derived_metric_count || database.derived_metrics.length}</dd></div>
            <div><dt>評価</dt><dd>{summary.evaluation_count || database.evaluations.length}</dd></div>
            <div><dt>根拠edge</dt><dd>{summary.evidence_edge_count || database.evidence_edges.length}</dd></div>
          </dl>
        </aside>
      </section>

      <section id="definition" class="section-block definition-section">
        <div class="section-heading">
          <div><p>01 / RESEARCH CONTRACT</p><h2>実績・派生値・評価を、<br /><em>混ぜずに接続する。</em></h2></div>
          <p class="section-note">一般的な決算サイトの情報量を模倣するのではなく、数値がどの資料・概念・式・判定へつながるかを明示します。</p>
        </div>
        <div class="logic-flow">
          <article><span>01</span><h3>Reported fact</h3><p>SEC提出値。XBRLタグ、単位、期間、accession、資料URLを保存。</p></article>
          <article><span>02</span><h3>Normalized concept</h3><p>タグ移行を吸収し、売上・OCF・CapEx等の比較可能な概念へ対応付け。</p></article>
          <article><span>03</span><h3>Derived metric</h3><p>FCF、利益率、YoY、CAGR、変動性を公開式で計算。</p></article>
          <article><span>04</span><h3>Evaluation</h3><p>閾値、値、PASS・WATCH・UNKNOWNを分解し、単一スコア化しない。</p></article>
          <article><span>05</span><h3>Evidence edge</h3><p>派生指標から元fact、評価から使用指標へ機械的に逆引き。</p></article>
        </div>
        <div class="formula-strip"><code>耐久年数 = 流動性準備 ÷ max(−ストレスFCF, 0)</code><span>利益剰余金は現金ではない。流動性と会計残高を分離します。</span></div>
      </section>

      <section id="quality" class="section-block">
        <div class="section-heading">
          <div><p>02 / DATA QUALITY</p><h2>結論より先に、<br /><em>データの状態を見る。</em></h2></div>
          <p class="section-note">期間型、XBRL概念、比較可能期間、欠損、代替タグを会社別に公開します。</p>
        </div>
        <div class="quality-summary">
          <article><span>COMPLETE</span><strong>{companies.filter((company) => company.metrics.data_completeness >= 0.8).length}<small>社</small></strong><p>必須一次factの80%以上を取得</p></article>
          <article><span>5-YEAR HISTORY</span><strong>{companies.filter((company) => company.history_years >= 5).length}<small>社</small></strong><p>年次履歴を5期取得</p></article>
          <article><span>QUARTERLY COMPARABLE</span><strong>{companies.filter((company) => company.metrics.revenue_yoy != null).length}<small>社</small></strong><p>前年同期の売上比較が可能</p></article>
          <article><span>ALTERNATIVE CAPEX TAG</span><strong>{companies.filter((company) => company.quality.flags.includes('alternative_capex_concept')).length}<small>社</small></strong><p>最新の等価XBRL概念へ移行</p></article>
        </div>
        <div class="quality-grid">
          {companies.map((company) => <article class="quality-card">
            <header><div><span>{company.ticker}</span><h3>{company.name}</h3></div><strong>{plainPercent(company.metrics.data_completeness)}</strong></header>
            <div class="quality-meter"><i style={`width:${Math.round(company.metrics.data_completeness * 100)}%`}></i></div>
            <div class="check-list">
              {Object.entries(company.quality.required_checks).map(([key, value]) => <span class={value ? 'check-pass' : 'check-missing'}>{value ? '✓' : '–'} {key.replaceAll('_', ' ')}</span>)}
            </div>
            <footer>{company.quality.flags.length ? company.quality.flags.map((flag) => <span>{qualityFlagLabels[flag] || flag}</span>) : <span>主要品質フラグなし</span>}</footer>
          </article>)}
        </div>
      </section>

      <section id="actuals" class="section-block">
        <div class="section-heading">
          <div><p>03 / ACTUALS</p><h2>四半期の収益性と、<br /><em>年次の資金創出を統合。</em></h2></div>
          <p class="section-note">四半期は成長と利益率、年次はFCF・流動性・設備投資を評価します。異なる期間型を無理に加算しません。</p>
        </div>
        <div class="actuals-summary">
          <article><span>売上高YoY 中央値</span><strong class={directionClass(overallMedians.revenueYoy)}>{percent(overallMedians.revenueYoy)}</strong><p>前年同期比較可能な企業のみ</p></article>
          <article><span>営業利益率 中央値</span><strong class={directionClass(overallMedians.operatingMargin)}>{plainPercent(overallMedians.operatingMargin, 1)}</strong><p>各社の最新四半期</p></article>
          <article><span>年次FCFマージン 中央値</span><strong class={directionClass(overallMedians.fcfMargin)}>{plainPercent(overallMedians.fcfMargin, 1)}</strong><p>各社の最新10-K</p></article>
          <article><span>最新年次期末</span><strong>{latestPeriod ? latestPeriod.slice(0, 4) : '—'}</strong><p>{dateJP(latestPeriod)}</p></article>
        </div>
        <div class="peer-group-grid">
          {research.peer_groups?.map((group) => <article>
            <span>{group.id.toUpperCase()}</span><h3>{group.label_ja}</h3><strong>{group.member_ids.length}<small>社</small></strong>
            <dl><div><dt>FCFマージン中央値</dt><dd>{plainPercent(group.medians.free_cash_flow_margin, 1)}</dd></div><div><dt>営業利益率中央値</dt><dd>{plainPercent(group.medians.operating_margin, 1)}</dd></div><div><dt>売上YoY中央値</dt><dd>{percent(group.medians.revenue_yoy)}</dd></div><div><dt>設備投資負担中央値</dt><dd>{plainPercent(group.medians.capex_intensity, 1)}</dd></div></dl>
          </article>)}
        </div>
      </section>

      <section id="peers" class="section-block">
        <div class="section-heading">
          <div><p>04 / PEER COMPARISON</p><h2>検索・分類・同業順位で、<br /><em>比較可能にする。</em></h2></div>
          <p class="section-note">金額の大きさだけでなく、利益率、成長、流動性、設備投資負担を同業中央値と比較します。</p>
        </div>
        <div class="controls" aria-label="企業フィルター">
          <label><span>企業検索</span><input id="company-search" type="search" placeholder="企業名・ティッカー" /></label>
          <label><span>役割</span><select id="role-filter"><option value="all">すべて</option><option value="semiconductor">半導体</option><option value="semiconductor-equipment">製造装置</option></select></label>
          <label><span>判定</span><select id="classification-filter"><option value="all">すべて</option><option value="resilient">耐久・創出力あり</option><option value="watch">要監視</option><option value="vulnerable">脆弱</option><option value="incomplete">データ不足</option></select></label>
          <span id="visible-count" class="visible-count">{companies.length}社表示</span>
        </div>
        <div class="table-wrap">
          <table class="research-table" id="peer-table">
            <thead><tr><th>企業</th><th><button data-sort="classification">判定</button></th><th><button data-sort="quality">品質</button></th><th><button data-sort="revenue-yoy">売上YoY</button></th><th><button data-sort="op-margin">営業利益率</button></th><th>利益率前年差</th><th><button data-sort="fcf-margin">FCFマージン</button></th><th>流動性/売上</th><th>CapEx/売上</th><th>深い下振れ</th></tr></thead>
            <tbody>
              {companies.map((company) => {
                const severe = runway(company);
                return <tr data-company-row data-search={`${company.name} ${company.ticker}`.toLowerCase()} data-role={company.role} data-classification={company.classification} data-sort-classification={({ vulnerable: 0, watch: 1, incomplete: 2, resilient: 3 })[company.classification]} data-sort-quality={company.metrics.data_completeness} data-sort-revenue-yoy={company.metrics.revenue_yoy ?? -999} data-sort-op-margin={company.metrics.operating_margin ?? -999} data-sort-fcf-margin={company.metrics.free_cash_flow_margin ?? -999}>
                  <td><strong>{company.name}</strong><span>{company.ticker} / {roleLabels[company.role]}</span></td>
                  <td><span class={`classification classification-${company.classification}`}>{classificationLabels[company.classification]}</span></td>
                  <td><strong>{plainPercent(company.metrics.data_completeness)}</strong><span>{company.history_years}年 / {company.quarter_history}四半期</span></td>
                  <td class={directionClass(company.metrics.revenue_yoy)}><strong>{percent(company.metrics.revenue_yoy)}</strong><span>{percentileLabel(peerPercentile(company, 'revenue_yoy'))}</span></td>
                  <td class={directionClass(company.metrics.operating_margin)}><strong>{plainPercent(company.metrics.operating_margin, 1)}</strong><span>{percentileLabel(peerPercentile(company, 'operating_margin'))}</span></td>
                  <td class={directionClass(company.metrics.operating_margin_delta_bps)}>{bps(company.metrics.operating_margin_delta_bps)}</td>
                  <td class={directionClass(company.metrics.free_cash_flow_margin)}><strong>{plainPercent(company.metrics.free_cash_flow_margin, 1)}</strong><span>{percentileLabel(peerPercentile(company, 'free_cash_flow_margin'))}</span></td>
                  <td>{plainPercent(company.metrics.liquidity_to_revenue, 1)}</td>
                  <td>{plainPercent(company.metrics.capex_intensity, 1)}</td>
                  <td><strong>{runwayLabel(severe)}</strong><span>{severe?.runway_band}</span></td>
                </tr>;
              })}
            </tbody>
          </table>
          <div id="empty-state" class="empty-state" hidden>条件に一致する企業がありません。</div>
        </div>
      </section>

      <section id="scenario" class="section-block">
        <div class="section-heading"><div><p>05 / SCENARIOS</p><h2>シナリオを、<br /><em>予測ではなく感応度として扱う。</em></h2></div><p class="section-note">全社共通の入力変化率で比較します。企業ガイダンスや確率予測ではありません。</p></div>
        <div class="scenario-grid">
          {legacyApi.scenarios.map((scenario) => <article><span>{scenario.id.toUpperCase()}</span><h3>{scenario.name}</h3><div><strong>OCF −{plainPercent(scenario.operating_cash_flow_decline)}</strong><strong>CapEx −{plainPercent(scenario.capital_expenditure_reduction)}</strong></div><p>{scenario.description}</p></article>)}
        </div>
      </section>

      <section id="ranking" class="section-block">
        <div class="section-heading"><div><p>06 / EXPLAINABLE EVALUATION</p><h2>耐久順位と、<br /><em>判定理由を分解する。</em></h2></div><p class="section-note">単一スコアではなく、6つの規則をPASS・WATCH・UNKNOWNで表示します。</p></div>
        <div class="classification-summary">
          {Object.entries(classificationLabels).map(([key, label]) => <article><span>{label}</span><strong>{summary.classification_counts?.[key] ?? companies.filter((company) => company.classification === key).length}<small>社</small></strong><p>{classificationDescriptions[key]}</p></article>)}
        </div>
        <div class="ranking-grid">
          {severeOrder.map((company, index) => {
            const severe = runway(company);
            return <article class="ranking-card">
              <header><span class="rank">{String(index + 1).padStart(2, '0')}</span><div><small>{company.ticker}</small><h3>{company.name}</h3></div><span class={`classification classification-${company.classification}`}>{classificationLabels[company.classification]}</span></header>
              <div class="ranking-metrics"><div><span>深い下振れ</span><strong>{runwayLabel(severe)}</strong></div><div><span>流動性準備</span><strong>{usd(company.metrics.liquid_reserve_usd)}</strong></div><div><span>基準FCF</span><strong class={directionClass(company.metrics.free_cash_flow_usd)}>{usd(company.metrics.free_cash_flow_usd)}</strong></div></div>
              <ul>{company.classification_reasons.map((reason) => <li>{reason}</li>)}</ul>
              <div class="evaluation-grid">
                {company.evaluations.map((evaluation) => <div class={`evaluation evaluation-${evaluation.result}`}><span>{evaluationRules[evaluation.rule_id]?.label_ja || evaluation.rule_id}</span><strong>{evaluationLabels[evaluation.result]}</strong></div>)}
              </div>
            </article>;
          })}
        </div>
      </section>

      <section id="history" class="section-block">
        <div class="section-heading"><div><p>07 / COMPANY EVIDENCE</p><h2>企業ごとに、<br /><em>数年推移と一次資料へ降りる。</em></h2></div><p class="section-note">年次と四半期の期間を分離したまま、元資料・XBRLタグ・会社APIへ接続します。</p></div>
        <div class="company-grid" id="company-cards">
          {companies.map((company) => {
            const latest = company.annual_history[0];
            const latestQuarter = company.quarterly_history[0];
            return <article class="company-card" data-company-card data-search={`${company.name} ${company.ticker}`.toLowerCase()} data-role={company.role} data-classification={company.classification}>
              <header><div><span>{company.ticker} / {roleLabels[company.role]}</span><h3>{company.name}</h3></div><a href={`${base}api/v1/semiconductor-resilience/companies/${company.id}.json`}>会社API ↗</a></header>
              <div class="company-kpis"><div><span>売上YoY</span><strong class={directionClass(company.metrics.revenue_yoy)}>{percent(company.metrics.revenue_yoy)}</strong></div><div><span>営業利益率</span><strong class={directionClass(company.metrics.operating_margin)}>{plainPercent(company.metrics.operating_margin, 1)}</strong></div><div><span>FCFマージン</span><strong class={directionClass(company.metrics.free_cash_flow_margin)}>{plainPercent(company.metrics.free_cash_flow_margin, 1)}</strong></div><div><span>純流動性</span><strong class={directionClass(company.metrics.net_liquidity_usd)}>{usd(company.metrics.net_liquidity_usd)}</strong></div></div>
              <div class="history-table"><table><thead><tr><th>年次期末</th><th>売上</th><th>OCF</th><th>CapEx</th><th>FCF</th><th>流動性</th></tr></thead><tbody>{company.annual_history.map((year) => <tr><td>{year.period_end}</td><td>{usd(year.revenue.reported_value)}</td><td>{usd(year.operating_cash_flow.reported_value)}</td><td>{usd(Math.abs(year.capital_expenditures.reported_value))}</td><td class={directionClass(year.free_cash_flow.reported_value)}>{usd(year.free_cash_flow.reported_value)}</td><td>{usd(year.liquid_reserve.reported_value)}</td></tr>)}</tbody></table></div>
              <div class="source-line"><span>年次 {latest.period_start}〜{latest.period_end}</span><a href={latest.operating_cash_flow.source_url}>SEC 10-K ↗</a>{latestQuarter && <><span>四半期 {latestQuarter.period_start}〜{latestQuarter.period_end}</span><a href={latestQuarter.revenue.source_url}>SEC 10-Q ↗</a></>}</div>
              <details><summary>XBRL概念と品質フラグ</summary><dl class="tag-list">{Object.entries(company.quality.selected_tags).map(([concept, tag]) => <div><dt>{concept}</dt><dd><code>{tag || 'unavailable'}</code></dd></div>)}</dl></details>
            </article>;
          })}
        </div>
      </section>

      <section id="ontology" class="section-block">
        <div class="section-heading"><div><p>08 / DATABASE & ONTOLOGY</p><h2>画面の裏側を、<br /><em>機械可読な関係モデルにする。</em></h2></div><p class="section-note">表示カードだけでなく、fact・concept・metric・evaluation・evidenceを独立テーブルとして公開します。</p></div>
        <div class="database-strip"><div><span>ISSUERS</span><strong>{database.entities.length}</strong></div><div><span>REPORTED FACTS</span><strong>{database.reported_facts.length}</strong></div><div><span>DERIVED METRICS</span><strong>{database.derived_metrics.length}</strong></div><div><span>EVALUATIONS</span><strong>{database.evaluations.length}</strong></div><div><span>EVIDENCE EDGES</span><strong>{database.evidence_edges.length}</strong></div></div>
        <div class="ontology-layout">
          <article><span>ENTITY TYPES</span><h3>{ontology.entity_types.length}種類</h3><div class="chip-cloud">{ontology.entity_types.map((entity) => <span title={entity.description}>{entity.label_ja}</span>)}</div></article>
          <article><span>RELATIONSHIPS</span><h3>{ontology.relationship_types.length}種類</h3><div class="relation-list">{ontology.relationship_types.map((relation) => <code>{relation.from} —{relation.id}→ {relation.to}</code>)}</div></article>
          <article><span>METRIC CATALOG</span><h3>{ontology.metric_catalog.length}指標</h3><div class="metric-catalog">{ontology.metric_catalog.map((metric) => <details><summary>{metric.label_ja}</summary><code>{metric.formula}</code><p>{metric.interpretation}</p></details>)}</div></article>
        </div>
        <div class="evidence-example"><span>根拠edgeの例</span>{database.evidence_edges.slice(0, 8).map((edge) => <code>{edge.from_id} —{edge.relationship}→ {edge.to_id}</code>)}</div>
      </section>

      <section id="benchmark" class="section-block">
        <div class="section-heading"><div><p>09 / MARKET BENCHMARK</p><h2>他サイトの強みと、<br /><em>未実装領域を隠さない。</em></h2></div><p class="section-note">公式機能ページで確認できた範囲のみを記録しています。未接続の予想・資料・価格データは作りません。</p></div>
        <div class="benchmark-summary"><article><span>調査サービス</span><strong>{benchmark.platforms.length}</strong><p>決算・IR・スクリーナー・品質標準</p></article><article><span>今回改善</span><strong>{benchmark.implementation_target.implemented.length}</strong><p>統合実績、同業比較、品質、評価、DB、オントロジー等</p></article><article><span>残る未接続</span><strong>{benchmark.implementation_target.remaining.length}</strong><p>予想、ガイダンス、トランスクリプト、株価、半導体KPI等</p></article><article><span>カテゴリ</span><strong>{benchmarkCategories.length}</strong><p>{benchmarkCategories.map(([category, count]) => `${category}:${count}`).join(' / ')}</p></article></div>
        <div class="implemented-grid"><article><span>IMPLEMENTED</span><ul>{benchmark.implementation_target.implemented.map((item) => <li>{item}</li>)}</ul></article><article><span>REMAINING</span><ul>{benchmark.implementation_target.remaining.map((item) => <li>{item}</li>)}</ul></article></div>
        <div class="platform-grid">{benchmark.platforms.map((platform) => <article><header><span>{platform.category}</span><h3>{platform.name}</h3></header><p>{platform.notable_strength}</p><div class="capabilities">{platform.capabilities.map((capability) => <span>{benchmark.capability_catalog.find((item) => item.id === capability)?.label_ja || capability}</span>)}</div><footer>{platform.sources.map((source, index) => <a href={source}>公式{index + 1} ↗</a>)}</footer></article>)}</div>
      </section>

      <section id="limits" class="section-block limits-section">
        <div class="section-heading"><div><p>10 / ANALYTICAL BOUNDARY</p><h2>まだ言えないことを、<br /><em>データモデル上にも残す。</em></h2></div></div>
        <div class="unsupported-grid">{ontology.unsupported_but_modeled_entity_types.map((item) => <article><span>{item.id}</span><h3>{item.id.replaceAll('_', ' ')}</h3><p>{item.reason}</p></article>)}</div>
        <div class="boundary-grid"><p><strong>倒産確率ではない。</strong> 借換余力、信用枠、運転資本、配当、自社株買い、M&A、リース、最低購入義務は耐久年数に含めていません。</p><p><strong>コンセンサスを推定しない。</strong> 一次データ提供元が未接続のため、予想、サプライズ、目標株価、改定履歴は空欄ではなく未対応領域として管理します。</p><p><strong>会社固有KPIは次段階。</strong> HBM、CoWoS、wafer starts、utilization、backlog等は資料抽出と語彙設計が必要です。</p><p><strong>期間型を維持する。</strong> 四半期利益と年次流動性は同じ画面で比較しても、同じ期間の値として加算しません。</p></div>
        <div class="provenance"><span>RESEARCH API HASH</span><code>{research.content_hash}</code><span>RESILIENCE API HASH</span><code>{legacyApi.content_hash}</code><span>BUILD SHA</span><code>{buildSha}</code></div>
      </section>
    </main>

    <script>
      const search = document.querySelector('#company-search');
      const role = document.querySelector('#role-filter');
      const classification = document.querySelector('#classification-filter');
      const rows = [...document.querySelectorAll('[data-company-row]')];
      const cards = [...document.querySelectorAll('[data-company-card]')];
      const visibleCount = document.querySelector('#visible-count');
      const emptyState = document.querySelector('#empty-state');
      const applyFilters = () => {
        const query = search.value.trim().toLowerCase();
        const roleValue = role.value;
        const classValue = classification.value;
        const matches = (element) => (!query || element.dataset.search.includes(query))
          && (roleValue === 'all' || element.dataset.role === roleValue)
          && (classValue === 'all' || element.dataset.classification === classValue);
        let visible = 0;
        rows.forEach((row) => { row.hidden = !matches(row); if (!row.hidden) visible += 1; });
        cards.forEach((card) => { card.hidden = !matches(card); });
        visibleCount.textContent = `${visible}社表示`;
        emptyState.hidden = visible !== 0;
      };
      [search, role, classification].forEach((control) => control.addEventListener('input', applyFilters));

      const tbody = document.querySelector('#peer-table tbody');
      document.querySelectorAll('[data-sort]').forEach((button) => button.addEventListener('click', () => {
        const key = button.dataset.sort;
        const direction = button.dataset.direction === 'desc' ? 'asc' : 'desc';
        button.dataset.direction = direction;
        [...tbody.querySelectorAll('tr')]
          .sort((left, right) => (Number(left.dataset[`sort${key.split('-').map((part) => part[0].toUpperCase() + part.slice(1)).join('')}`]) - Number(right.dataset[`sort${key.split('-').map((part) => part[0].toUpperCase() + part.slice(1)).join('')}`])) * (direction === 'asc' ? 1 : -1))
          .forEach((row) => tbody.appendChild(row));
      }));
    </script>
  </body>
</html>

