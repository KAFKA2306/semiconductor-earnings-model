---
import fs from 'node:fs';
import path from 'node:path';

const root = process.cwd().endsWith('site') ? path.resolve(process.cwd(), '..') : process.cwd();
const data = JSON.parse(fs.readFileSync(path.join(root, 'site/public/api/v3/china-ai/index.json'), 'utf8'));
const base = import.meta.env.BASE_URL;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
if (!buildSha) throw new Error('PUBLIC_BUILD_SHA is required for provenance');
const observations = data.observations ?? [];
const sourceMap = data.sources ?? {};
const categories = [...new Set(observations.map((row) => row.category))];
const displayValue = (row) => `${row.qualifier === '=' ? '' : row.qualifier}${row.value} ${row.unit}`;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="中国AI産業の算力、token価格、国産compute、導入、売上、ソフトウェア生態系を一次情報の定量値だけで追跡する公開データページ。" />
  <title>China AI Quantitative Monitor</title>
  <link rel="stylesheet" href={base + 'assets/aux-workbench.css'} />
</head>
<body data-workbench data-aux-workbench data-build-sha={buildSha}>
<main>
  <header>
    <a href={base}>Financial Research Workbench</a>
    <a href={`${base}api/v3/china-ai/index.json`}>JSON API</a>
  </header>
  <section class="hero">
    <p>PRIMARY SOURCES × QUANTITATIVE OBSERVATIONS</p>
    <h1>China AI<br/><em>Quantitative Monitor</em></h1>
    <p class="lead">評価・スコア・投資判断を置かず、中国AI産業の公開一次情報から取得できる数値だけを同じ形式で保存します。</p>
    <dl>
      <div><dt>Observations</dt><dd>{observations.length}</dd></div>
      <div><dt>Categories</dt><dd>{categories.length}</dd></div>
      <div><dt>Primary URLs</dt><dd>{Object.keys(sourceMap).length}</dd></div>
      <div><dt>As of</dt><dd>{data.as_of}</dd></div>
    </dl>
  </section>
  {categories.map((category) => (
    <section>
      <h2>{category.replaceAll('_', ' ')}</h2>
      <div class="table-wrap"><table>
        <thead><tr><th>Entity</th><th>Period</th><th>Metric</th><th>Value</th><th>Source date</th><th>Primary source</th></tr></thead>
        <tbody>{observations.filter((row) => row.category === category).map((row) => {
          const source = sourceMap[row.source];
          return <tr><td>{row.entity}</td><td>{row.period}</td><td><code>{row.metric}</code></td><td><strong>{displayValue(row)}</strong></td><td>{source?.date ?? 'missing'}</td><td><a href={source?.url} rel="noreferrer">{source?.title ?? row.source}</a></td></tr>;
        })}</tbody>
      </table></div>
    </section>
  ))}
  <footer><span>SCHEMA</span><code>{data.schema_version}</code><span>BUILD SHA</span><code>{buildSha}</code></footer>
</main>
</body>
</html>
