---
import fs from 'node:fs';
import path from 'node:path';

const root = process.cwd().endsWith('site') ? path.resolve(process.cwd(), '..') : process.cwd();
const financial = JSON.parse(fs.readFileSync(path.join(root, 'site/public/api/v3/financial-database/index.json'), 'utf8'));
const infrastructure = JSON.parse(fs.readFileSync(path.join(root, 'api/v1/ai-infrastructure/index.json'), 'utf8'));
const base = import.meta.env.BASE_URL;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
if (!buildSha) throw new Error('PUBLIC_BUILD_SHA is required for provenance');

const observations = infrastructure.observations || [];
const byAsOf = [...observations].sort((a, b) => (a.as_of || '').localeCompare(b.as_of || '') || (a.period_end || '').localeCompare(b.period_end || ''));
const latestEvidenceDate = byAsOf.at(-1)?.as_of || '未取得';
const all = (concept, valueType = 'actual', entity = null) => observations
  .filter((row) => row.concept_id === concept && row.value_type === valueType && (!entity || row.entity === entity))
  .sort((a, b) => (a.period_end || '').localeCompare(b.period_end || '') || (a.as_of || '').localeCompare(b.as_of || ''));
const latest = (concept, valueType = 'actual', entity = null) => all(concept, valueType, entity).at(-1);
const previousComparable = (concept, entity) => {
  const rows = all(concept, 'actual', entity);
  const current = rows.at(-1);
  if (!current) return null;
  return [...rows].reverse().slice(1).find((row) => row.unit === current.unit && row.value != null) || null;
};

const msftTotalCapex = all('capital_expenditures', 'actual', 'Microsoft Corporation');
const msftCapexActual = msftTotalCapex.at(-1);
const msftCapexPrevious = msftTotalCapex.at(-2);
const msftCapexGuidance = latest('capital_expenditures', 'company_guidance', 'Microsoft Corporation');
const nvdaCompute = latest('data_center_compute_revenue', 'actual', 'NVIDIA Corporation');
const nvdaNetwork = latest('data_center_networking_revenue', 'actual', 'NVIDIA Corporation');
const micronMemory = latest('data_center_ssd_revenue', 'actual', 'Micron Technology, Inc.');
const msftPower = latest('energy_capacity_added', 'actual', 'Microsoft Corporation');

const usdB = (row) => row?.value == null ? '未取得' : `${row.qualifier === 'greater_than' ? '>' : ''}$${(Number(row.value) / 1e9).toFixed(Number(row.value) % 1e9 === 0 ? 0 : 1)}B`;
const percent = (value) => `${value >= 0 ? '+' : ''}${(value * 100).toFixed(1)}%`;
const capexQoq = msftCapexActual && msftCapexPrevious ? Number(msftCapexActual.value) / Number(msftCapexPrevious.value) - 1 : null;
const relativeChange = (current, previous) => {
  if (!current || !previous || current.value == null || previous.value == null) return null;
  const previousValue = Number(previous.value);
  if (!Number.isFinite(previousValue) || previousValue === 0 || current.unit !== previous.unit) return null;
  return Number(current.value) / previousValue - 1;
};
const formatLaneValue = (row) => {
  if (!row || row.value == null) return '未取得';
  if (row.unit === 'USD') return usdB(row);
  return `${Number(row.value).toLocaleString('en-US')} ${row.unit || ''}`.trim();
};
const lane = (label, concept, entity, description) => {
  const current = latest(concept, 'actual', entity);
  const previous = previousComparable(concept, entity);
  const change = relativeChange(current, previous);
  return { label, current, previous, change, description };
};
const lanes = [
  lane('Compute', 'data_center_compute_revenue', 'NVIDIA Corporation', 'NVIDIA DC compute revenue'),
  lane('Network', 'data_center_networking_revenue', 'NVIDIA Corporation', 'NVIDIA DC networking revenue'),
  lane('Memory', 'data_center_ssd_revenue', 'Micron Technology, Inc.', 'Micron data-center SSD revenue'),
  lane('Power', 'energy_capacity_added', 'Microsoft Corporation', 'Microsoft capacity added'),
];

const entityLookup = financial.views?.entity_lookup || {};
const comparisons = financial.views?.nand_kpi_comparisons || [];
const latestByEntity = new Map();
for (const row of comparisons) {
  const current = latestByEntity.get(row.entity_id);
  if (!current || row.period_end > current.period_end) latestByEntity.set(row.entity_id, row);
}
const latestNand = [...latestByEntity.values()].sort((a, b) => a.entity_id.localeCompare(b.entity_id));
const interval = (row, digits = 1) => {
  if (!row) return '未取得';
  if (row.value != null) return `${Number(row.value) >= 0 ? '+' : ''}${(Number(row.value) * 100).toFixed(digits)}%`;
  if (row.value_low == null || row.value_high == null) return '未取得';
  const low = Number(row.value_low) * 100;
  const high = Number(row.value_high) * 100;
  return `${low >= 0 ? '+' : ''}${low.toFixed(digits)}〜${high >= 0 ? '+' : ''}${high.toFixed(digits)}%`;
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="AI計算資源・半導体供給の最新一次情報と、半導体・NANDの市況、企業業績、投資余力を確認できる公開データサイト。" />
    <title>AI Infrastructure / 半導体業績データ</title>
  </head>
  <body data-build-sha={buildSha} data-financial-api-hash={financial.content_hash} data-ai-infrastructure-schema={infrastructure.schema_version}>
    <main>
      <header>
        <a class="brand" href={base}>AI Infrastructure / 半導体</a>
        <nav aria-label="ページ内ナビゲーション">
          <a href="#today">Today</a>
          <a href="#market">市況</a>
          <a href="#companies">企業</a>
          <a href="#evidence">根拠</a>
        </nav>
      </header>

      <section class="hero">
        <p class="eyebrow">PRIMARY EVIDENCE / ACTUAL ≠ GUIDANCE</p>
        <h1>AIインフラで、最後に何が変わったか。</h1>
        <p class="lead">最新値だけでなく、同じconcept・entity・unitの前回actualとの差まで確認できます。実績、会社予想、SEC cash-flow factは混ぜません。</p>
        <a class="primary-action" href="#today">最新の変化を見る ↓</a>
      </section>

      <section id="today" class="section today">
        <div class="section-title">
          <span>00</span>
          <div>
            <h2>Today — 最新の確認済み事実。</h2>
            <p>このviewに入っている一次情報の最新公表日は <strong>{latestEvidenceDate}</strong>。異なる定義・unit・periodを横断した独自scoreは作りません。</p>
          </div>
        </div>

        <div class="headline-grid">
          <article class="headline-card primary">
            <span class="label">Microsoft total CapEx · actual</span>
            <strong>{usdB(msftCapexActual)}</strong>
            <p>{msftCapexActual?.fiscal_period || '—'} FY{msftCapexActual?.fiscal_year || '—'} · period end {msftCapexActual?.period_end || '—'}</p>
            <p class="delta">{capexQoq == null ? '比較不能' : `${percent(capexQoq)} vs previous actual`}</p>
            {msftCapexActual?.source_url && <a href={msftCapexActual.source_url}>一次資料 →</a>}
          </article>
          <article class="headline-card guidance">
            <span class="label">Microsoft total CapEx · company guidance</span>
            <strong>{usdB(msftCapexGuidance)}</strong>
            <p>{msftCapexGuidance?.fiscal_period || '—'} FY{msftCapexGuidance?.fiscal_year || '—'} · future period {msftCapexGuidance?.period_end || '—'}</p>
            <p class="delta">guidanceをactualとして扱わない</p>
            {msftCapexGuidance?.source_url && <a href={msftCapexGuidance.source_url}>一次資料 →</a>}
          </article>
          <article class="headline-card">
            <span class="label">NVIDIA Data Center compute · actual</span>
            <strong>{usdB(nvdaCompute)}</strong>
            <p>{nvdaCompute?.fiscal_period || '—'} FY{nvdaCompute?.fiscal_year || '—'} · as-of {nvdaCompute?.as_of || '—'}</p>
            {nvdaCompute?.source_url && <a href={nvdaCompute.source_url}>一次資料 →</a>}
          </article>
          <article class="headline-card">
            <span class="label">Micron data-center SSD · actual</span>
            <strong>{usdB(micronMemory)}</strong>
            <p>{micronMemory?.fiscal_period || '—'} FY{micronMemory?.fiscal_year || '—'} · as-of {micronMemory?.as_of || '—'}</p>
            {micronMemory?.source_url && <a href={micronMemory.source_url}>一次資料 →</a>}
          </article>
        </div>

        <div class="change-intro">
          <strong>前回の比較可能actualからの変化</strong>
          <span>同一concept・entity・unitだけを比較。比較対象がなければ「比較可能な前回値なし」と表示します。</span>
        </div>
        <div class="lane-grid" aria-label="AI infrastructure comparable changes">
          {lanes.map((item) => (
            <article class="lane-card">
              <div class="lane-heading">
                <span>{item.label}</span>
                <small>{item.current?.period_end || item.current?.as_of || '未取得'}</small>
              </div>
              <strong>{formatLaneValue(item.current)}</strong>
              <p class="lane-change" data-change-state={item.change == null ? 'unavailable' : item.change > 0 ? 'up' : item.change < 0 ? 'down' : 'flat'}>
                {item.change == null ? '比較可能な前回値なし' : `${percent(item.change)} vs previous actual`}
              </p>
              <small>{item.description}</small>
              {item.previous && <small>前回: {formatLaneValue(item.previous)} · {item.previous.period_end || item.previous.as_of || '—'}</small>}
              {item.current?.source_url && <a href={item.current.source_url}>一次資料 →</a>}
            </article>
          ))}
        </div>

        <div class="definition-warning">
          <strong>重要な定義境界</strong>
          <p>Microsoftが会社開示するtotal CapExと、SEC XBRL <code>PaymentsToAcquirePropertyPlantAndEquipment</code>から得るcash paid for PP&amp;Eは別conceptです。finance lease等を含むtotal CapExとcash-flow factを同じ系列で差分計算しません。</p>
        </div>
        <p class="coverage-note">現在のcanonical daily coverageは capital investment / compute / memory / network / power。foundry / WFE / EDA / HBM専用laneは、比較可能なcanonical observationが追加されるまで未収録として扱います。</p>
      </section>

      <section id="market" class="section">
        <div class="section-title">
          <span>01</span>
          <div>
            <h2>次に、市況を見る。</h2>
            <p>NANDの平均販売価格（ASP）とbit出荷量の変化です。YoYは比較可能な連続四半期から計算しています。</p>
          </div>
        </div>

        {latestNand.length ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>企業</th><th>期末</th><th>価格 QoQ</th><th>価格 YoY</th><th>bit出荷 QoQ</th><th>bit出荷 YoY</th></tr>
              </thead>
              <tbody>
                {latestNand.map((row) => (
                  <tr>
                    <td><strong>{entityLookup[row.entity_id]?.name || row.entity_id}</strong><small>{entityLookup[row.entity_id]?.ticker || row.entity_id}</small></td>
                    <td>{row.period_end}</td>
                    <td>{interval(row.asp?.qoq_actual)}</td>
                    <td>{interval(row.asp?.yoy_derived)}</td>
                    <td>{interval(row.bit_shipments?.qoq_actual)}</td>
                    <td>{interval(row.bit_shipments?.yoy_derived)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <p class="empty">比較可能なNANDデータはまだありません。</p>}
      </section>

      <section id="companies" class="section split">
        <span class="number">02</span>
        <div><h2>企業の利益と耐久力を見る。</h2><p>売上、営業利益、利益率、フリーキャッシュフロー、流動性を同業で比較します。市場が強くても、利益として残っているかは別に確認します。</p><a class="button" href={`${base}resilience/`}>企業比較を見る →</a></div>
      </section>

      <section id="demand" class="section split">
        <span class="number">03</span>
        <div><h2>需要を支える資金を見る。</h2><p>Amazon、Alphabet、Meta、Microsoftなどの営業キャッシュフローと設備投資を確認し、AI・データセンター投資を継続できる資金余力を追います。</p><a class="button" href={`${base}earnings/`}>顧客の資金余力を見る →</a></div>
      </section>

      <section class="section split">
        <span class="number">04</span>
        <div><h2>どこまで言えるかを見る。</h2><p>観測済みの事実と、まだ係数や因果が不足している区間を分けます。データが足りない将来利益は埋めません。</p><a class="button" href={`${base}model/`}>計算できる範囲を見る →</a></div>
      </section>

      <section id="evidence" class="section evidence">
        <div class="section-title"><span>05</span><div><h2>必要なら、根拠まで降りる。</h2><p>一次fact、期間、単位、出典URL、派生値との関係を機械可読データで確認できます。</p></div></div>
        <div class="links">
          <a href={`${base}api/v1/ai-infrastructure/index.json`}><strong>AI Infrastructure JSON</strong><span>actual / guidance / concept定義を確認</span></a>
          <a href={`${base}api/v3/financial-database/index.json`}><strong>Financial DB JSON</strong><span>ブラウザやプログラムから読む</span></a>
          <a href={`${base}api/v3/financial-database/financial.db`}><strong>SQLite</strong><span>まとめて取得して分析する</span></a>
          <a href={`${base}earnings/`}><strong>一次資料台帳</strong><span>SEC提出書類と原factを見る</span></a>
        </div>
      </section>

      <footer>
        <span>データ監査: {financial.audit?.status || 'UNKNOWN'}</span><span>AI infrastructure observations: {observations.length}</span><span>最新一次情報: {latestEvidenceDate}</span>
        <details><summary>build情報</summary><code>{buildSha}</code><code>{financial.content_hash}</code><code>{infrastructure.schema_version}</code></details>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; color: #17233F; background: #F7F5EF; font: 14px/1.55 Inter, "Noto Sans JP", system-ui, sans-serif; }
  :global(a) { color: #2563EB; }
  :global(a:focus-visible), :global(button:focus-visible) { outline: 2px solid #2563EB; outline-offset: 2px; }
  main { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding-bottom: 64px; }
  header { min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid #D9D6CE; }
  .brand { color: #17233F; font-weight: 900; text-decoration: none; }
  nav { display: flex; gap: 16px; font-size: 12px; font-weight: 800; }
  nav a { min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .hero { max-width: 860px; padding: 64px 0 48px; }
  .eyebrow { margin: 0 0 12px; color: #667085; font: 700 12px/1.4 "Roboto Mono", "SFMono-Regular", Consolas, monospace; letter-spacing: .08em; }
  h1, h2 { margin: 0; color: #17233F; font-family: Inter, "Noto Sans JP", system-ui, sans-serif; letter-spacing: -.025em; }
  h1 { font-size: clamp(2.5rem, 7vw, 5rem); line-height: 1.02; }
  h2 { font-size: clamp(1.7rem, 3.6vw, 2.8rem); line-height: 1.08; }
  .lead { max-width: 760px; margin: 16px 0 0; color: #667085; font-size: 1rem; line-height: 1.8; }
  .primary-action, .button { min-height: 44px; display: inline-flex; align-items: center; margin-top: 16px; padding: 0 16px; border: 1px solid #D9D6CE; border-radius: 2px; background: #FFFFFF; color: #17233F; text-decoration: none; font-weight: 800; }
  .primary-action { border-color: #2563EB; background: #2563EB; color: #FFFFFF; }
  .section { padding: 56px 0; border-top: 1px solid #D9D6CE; }
  .section-title, .split { display: grid; grid-template-columns: 56px 1fr; gap: 20px; }
  .section-title > span, .number { color: #667085; font: 500 20px/1 "Roboto Mono", "SFMono-Regular", Consolas, monospace; }
  .section p { max-width: 780px; color: #667085; line-height: 1.75; }
  .headline-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 28px; }
  .headline-card { display: flex; min-height: 220px; flex-direction: column; padding: 16px; border: 1px solid #D9D6CE; background: #FFFFFF; }
  .headline-card.primary { border-top: 4px solid #2563EB; }
  .headline-card.guidance { border-top: 4px dashed #A16207; }
  .headline-card .label { min-height: 38px; color: #667085; font-size: 12px; font-weight: 800; }
  .headline-card > strong { margin-top: 12px; font: 700 clamp(2rem, 4vw, 3rem)/1.1 "Roboto Mono", "SFMono-Regular", Consolas, monospace; letter-spacing: -.04em; }
  .headline-card p { margin: 8px 0 0; font-size: 12px; line-height: 1.5; }
  .headline-card .delta { color: #17233F; font-weight: 800; }
  .headline-card a, .lane-card a { margin-top: auto; padding-top: 16px; font-size: 12px; font-weight: 800; }
  .change-intro { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; margin-top: 20px; padding: 12px 0; border-bottom: 1px solid #D9D6CE; }
  .change-intro span { color: #667085; font-size: 12px; }
  .lane-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 12px; }
  .lane-card { display: flex; min-height: 190px; flex-direction: column; padding: 16px; border: 1px solid #D9D6CE; background: #FFFFFF; }
  .lane-heading { display: flex; justify-content: space-between; gap: 8px; }
  .lane-heading span { font-weight: 900; }
  .lane-heading small, .lane-card small { color: #667085; font-size: 12px; }
  .lane-card > strong { margin-top: 12px; font: 700 20px/1.2 "Roboto Mono", "SFMono-Regular", Consolas, monospace; }
  .lane-change { margin: 10px 0 8px !important; color: #17233F !important; font-weight: 900; }
  .lane-change[data-change-state="up"] { color: #15803D !important; }
  .lane-change[data-change-state="down"] { color: #B91C1C !important; }
  .lane-change[data-change-state="unavailable"] { color: #667085 !important; font-weight: 700; }
  .definition-warning { margin-top: 18px; padding: 16px; border-left: 4px solid #A16207; background: #FFFFFF; }
  .definition-warning p { margin-bottom: 0; }
  .coverage-note { font-size: 12px; }
  .table-wrap { margin-top: 28px; overflow-x: auto; border: 1px solid #D9D6CE; background: #FFFFFF; }
  table { width: 100%; min-width: 760px; border-collapse: collapse; }
  th, td { height: 30px; padding: 10px 12px; border-bottom: 1px solid #D9D6CE; text-align: right; white-space: nowrap; font-size: 12px; }
  th { color: #667085; }
  th:first-child, td:first-child { text-align: left; }
  td strong, td small { display: block; }
  td small { margin-top: 3px; color: #667085; }
  .empty { padding: 16px; border: 1px solid #D9D6CE; background: #FFFFFF; }
  .links { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 24px; }
  .links a { min-height: 110px; padding: 16px; border: 1px solid #D9D6CE; background: #FFFFFF; text-decoration: none; }
  .links strong, .links span { display: block; }
  .links span { margin-top: 8px; color: #667085; font-size: 12px; line-height: 1.6; }
  footer { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding-top: 24px; border-top: 1px solid #D9D6CE; color: #667085; font-size: 12px; }
  footer details { margin-left: auto; }
  footer code { display: block; max-width: 420px; margin-top: 6px; overflow-wrap: anywhere; }
  @media (max-width: 900px) { .headline-grid, .lane-grid, .links { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    header { align-items: flex-start; flex-direction: column; padding: 8px 0; }
    nav { width: 100%; overflow-x: auto; }
    .hero { padding: 48px 0 40px; }
    .section-title, .split { grid-template-columns: 36px 1fr; gap: 12px; }
    .headline-grid, .lane-grid, .links { grid-template-columns: 1fr; }
    .headline-card, .lane-card { min-height: 0; }
    footer details { width: 100%; margin-left: 0; }
  }
</style>