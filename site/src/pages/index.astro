---
import fs from 'node:fs';
import path from 'node:path';

const root = process.cwd().endsWith('site') ? path.resolve(process.cwd(), '..') : process.cwd();
const financial = JSON.parse(fs.readFileSync(path.join(root, 'site/public/api/v3/financial-database/index.json'), 'utf8'));
const base = import.meta.env.BASE_URL;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
if (!buildSha) throw new Error('PUBLIC_BUILD_SHA is required for provenance');

const entityLookup = financial.views?.entity_lookup || {};
const comparisons = financial.views?.nand_kpi_comparisons || [];
const latestByEntity = new Map();
for (const row of comparisons) {
  const current = latestByEntity.get(row.entity_id);
  if (!current || row.period_end > current.period_end) latestByEntity.set(row.entity_id, row);
}
const latestNand = [...latestByEntity.values()].sort((a, b) => a.entity_id.localeCompare(b.entity_id));
const interval = (row, digits = 1) => {
  if (!row) return '未取得';
  if (row.value != null) return `${Number(row.value) >= 0 ? '+' : ''}${(Number(row.value) * 100).toFixed(digits)}%`;
  if (row.value_low == null || row.value_high == null) return '未取得';
  const low = Number(row.value_low) * 100;
  const high = Number(row.value_high) * 100;
  return `${low >= 0 ? '+' : ''}${low.toFixed(digits)}〜${high >= 0 ? '+' : ''}${high.toFixed(digits)}%`;
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="半導体・NANDの市況、企業業績、顧客の投資余力、一次資料を順に確認できる公開データサイト。" />
    <title>半導体業績データ</title>
  </head>
  <body data-build-sha={buildSha} data-financial-api-hash={financial.content_hash}>
    <main>
      <header>
        <a class="brand" href={base}>半導体業績データ</a>
        <nav aria-label="ページ内ナビゲーション">
          <a href="#market">市況</a>
          <a href="#companies">企業</a>
          <a href="#demand">需要</a>
          <a href="#evidence">根拠</a>
        </nav>
      </header>

      <section class="hero">
        <p class="eyebrow">PRIMARY DATA / UPDATED CONTINUOUSLY</p>
        <h1>半導体の今を、<br />数字から読む。</h1>
        <p class="lead">見る順番は4つだけです。市況 → 企業 → 需要 → 根拠。分析画面の名前や内部のデータ構造を先に覚える必要はありません。</p>
      </section>

      <section id="market" class="section">
        <div class="section-title">
          <span>01</span>
          <div>
            <h2>まず、市況を見る。</h2>
            <p>NANDの平均販売価格（ASP）とbit出荷量の変化です。YoYは比較可能な連続四半期から計算しています。</p>
          </div>
        </div>

        {latestNand.length ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>企業</th>
                  <th>期末</th>
                  <th>価格 QoQ</th>
                  <th>価格 YoY</th>
                  <th>bit出荷 QoQ</th>
                  <th>bit出荷 YoY</th>
                </tr>
              </thead>
              <tbody>
                {latestNand.map((row) => (
                  <tr>
                    <td><strong>{entityLookup[row.entity_id]?.name || row.entity_id}</strong><small>{entityLookup[row.entity_id]?.ticker || row.entity_id}</small></td>
                    <td>{row.period_end}</td>
                    <td>{interval(row.asp?.qoq_actual)}</td>
                    <td>{interval(row.asp?.yoy_derived)}</td>
                    <td>{interval(row.bit_shipments?.qoq_actual)}</td>
                    <td>{interval(row.bit_shipments?.yoy_derived)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="empty">比較可能なNANDデータはまだありません。</p>
        )}
      </section>

      <section id="companies" class="section split">
        <span class="number">02</span>
        <div>
          <h2>次に、企業を見る。</h2>
          <p>売上、営業利益、利益率、フリーキャッシュフロー、流動性を同業で比較します。市場が強くても、利益として残っているかは別に確認します。</p>
          <a class="button" href={`${base}resilience/`}>企業比較を見る →</a>
        </div>
      </section>

      <section id="demand" class="section split">
        <span class="number">03</span>
        <div>
          <h2>その後、需要を支える資金を見る。</h2>
          <p>Amazon、Alphabet、Meta、Microsoftなどの営業キャッシュフローと設備投資を確認し、AI・データセンター投資を継続できる資金余力を追います。</p>
          <a class="button" href={`${base}earnings/`}>顧客の資金余力を見る →</a>
        </div>
      </section>

      <section class="section split">
        <span class="number">04</span>
        <div>
          <h2>最後に、どこまで言えるかを見る。</h2>
          <p>観測済みの事実と、まだ係数や因果が不足している区間を分けます。データが足りない将来利益は埋めません。</p>
          <a class="button" href={`${base}model/`}>計算できる範囲を見る →</a>
        </div>
      </section>

      <section id="evidence" class="section evidence">
        <div class="section-title">
          <span>05</span>
          <div>
            <h2>必要なら、根拠まで降りる。</h2>
            <p>一次fact、期間、単位、出典URL、派生値との関係を機械可読データで確認できます。</p>
          </div>
        </div>
        <div class="links">
          <a href={`${base}api/v3/financial-database/index.json`}><strong>JSON</strong><span>ブラウザやプログラムから読む</span></a>
          <a href={`${base}api/v3/financial-database/financial.db`}><strong>SQLite</strong><span>まとめて取得して分析する</span></a>
          <a href={`${base}earnings/`}><strong>一次資料</strong><span>SEC提出書類と原factを見る</span></a>
        </div>
      </section>

      <footer>
        <span>データ監査: {financial.audit?.status || 'UNKNOWN'}</span>
        <span>観測値: {financial.audit?.counts?.observations ?? financial.observations?.length ?? 0}</span>
        <details>
          <summary>build情報</summary>
          <code>{buildSha}</code>
          <code>{financial.content_hash}</code>
        </details>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; color: #243653; background: #fbfaf7; font-family: Inter, "Noto Sans JP", system-ui, sans-serif; }
  :global(a) { color: inherit; }
  main { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding-bottom: 64px; }
  header { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-bottom: 1px solid #dde1e7; }
  .brand { font-weight: 900; text-decoration: none; }
  nav { display: flex; gap: 18px; font-size: .78rem; font-weight: 800; }
  nav a { text-decoration: none; }
  .hero { max-width: 900px; padding: 96px 0 88px; }
  .eyebrow { margin: 0 0 18px; color: #69768b; font-size: .68rem; font-weight: 900; letter-spacing: .14em; }
  h1, h2 { margin: 0; font-family: Georgia, "Noto Serif JP", serif; font-weight: 500; letter-spacing: -.035em; }
  h1 { font-size: clamp(3.2rem, 8vw, 6.5rem); line-height: 1; }
  h2 { font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1.08; }
  .lead { max-width: 700px; margin: 28px 0 0; color: #69768b; font-size: 1rem; line-height: 1.9; }
  .section { padding: 72px 0; border-top: 1px solid #dde1e7; }
  .section-title, .split { display: grid; grid-template-columns: 72px 1fr; gap: 28px; }
  .section-title > span, .number { color: #8a6e98; font: 500 2rem Georgia, serif; }
  .section p { max-width: 760px; color: #69768b; line-height: 1.85; }
  .table-wrap { margin-top: 34px; overflow-x: auto; border: 1px solid #dde1e7; background: #fff; }
  table { width: 100%; min-width: 760px; border-collapse: collapse; }
  th, td { padding: 15px 14px; border-bottom: 1px solid #e7e9ed; text-align: right; white-space: nowrap; font-size: .8rem; }
  th { color: #69768b; font-size: .69rem; }
  th:first-child, td:first-child { text-align: left; }
  td strong, td small { display: block; }
  td small { margin-top: 3px; color: #69768b; }
  .empty { padding: 22px; border: 1px solid #dde1e7; background: #fff; }
  .button { display: inline-block; margin-top: 18px; padding: 12px 16px; border: 1px solid #cfd5de; border-radius: 999px; background: #fff; text-decoration: none; font-size: .82rem; font-weight: 850; }
  .links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 30px; }
  .links a { min-height: 110px; padding: 20px; border: 1px solid #dde1e7; background: #fff; text-decoration: none; }
  .links strong, .links span { display: block; }
  .links span { margin-top: 10px; color: #69768b; font-size: .78rem; line-height: 1.6; }
  footer { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding-top: 24px; border-top: 1px solid #dde1e7; color: #69768b; font-size: .72rem; }
  footer details { margin-left: auto; }
  footer code { display: block; max-width: 420px; margin-top: 6px; overflow-wrap: anywhere; }
  @media (max-width: 720px) {
    nav { gap: 10px; font-size: .7rem; }
    .hero { padding: 72px 0 64px; }
    .section-title, .split { grid-template-columns: 44px 1fr; gap: 14px; }
    .links { grid-template-columns: 1fr; }
    footer details { width: 100%; margin-left: 0; }
  }
</style>
