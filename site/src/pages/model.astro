---
import fs from 'node:fs';
import path from 'node:path';
import { DEMAND_COHORTS, buildDemandAggregation } from '../lib/demand-aggregation.js';

const root = process.cwd().endsWith('site') ? path.resolve(process.cwd(), '..') : process.cwd();
const profitApi = JSON.parse(fs.readFileSync(path.join(root, 'site/public/api/v1/semiconductor-profit/index.json'), 'utf8'));
const demandApi = JSON.parse(fs.readFileSync(path.join(root, 'site/public/api/v1/demand/index.json'), 'utf8'));
const base = import.meta.env.BASE_URL;
const buildSha = import.meta.env.PUBLIC_BUILD_SHA;
if (!buildSha) throw new Error('PUBLIC_BUILD_SHA is required for provenance');

const usd = (value) => `$${(Number(value) / 1_000_000_000).toFixed(1)}B`;
const dateJP = (value) => {
  if (!value) return '期間未確定';
  const [year, month, day] = value.slice(0, 10).split('-').map(Number);
  return `${year}/${month}/${day}`;
};
const roleJP = {
  hyperscaler: 'Hyperscaler',
  'ai-cloud': 'AI cloud',
  'data-center-operator': 'Data center',
  'cloud-provider': 'Cloud',
};
const demandCompanies = demandApi.companies.filter((company) => company.quarters.length > 0);
const latestDemand = (company) => company.quarters[0];
const demandAggregation = buildDemandAggregation(demandApi);
const commonDemandPeriod = demandAggregation.commonPeriod;
const commonDemandCompanies = demandAggregation.commonCompanies;
const profitCompanies = profitApi.companies.filter((company) => company.quarters.length > 0);
const profitHistoryQuarters = profitCompanies.length
  ? Math.min(...profitCompanies.map((company) => company.quarters.length))
  : 0;
const fcf = (company) => latestDemand(company).operating_cash_flow.value_usd - latestDemand(company).capital_expenditures.value_usd;
const burden = (company) => {
  const ocf = Number(latestDemand(company).operating_cash_flow.value_usd);
  return ocf ? Number(latestDemand(company).capital_expenditures.value_usd) / ocf * 100 : null;
};
const pct = (value) => value == null ? '—' : `${value.toFixed(1)}%`;
const comparableCohorts = demandAggregation.cohorts.filter((cohort) => cohort.comparableBurden != null);
const maxCompanyCash = Math.max(...demandCompanies.map((company) => Math.abs(Number(latestDemand(company).operating_cash_flow.value_usd))), 1);
const cashBar = (value) => `${Math.max(3, Math.min(100, Math.abs(Number(value)) / maxCompanyCash * 100)).toFixed(1)}%`;
const aggregateBar = (value) => `${Math.max(3, Math.min(100, Math.abs(Number(value)) / demandAggregation.scale * 100)).toFixed(1)}%`;
const cohortRows = DEMAND_COHORTS.map((cohort) => {
  const rows = demandCompanies.filter((company) => cohort.roles.includes(company.role));
  const periods = [...new Set(rows.map((company) => latestDemand(company).period_end))];
  return { ...cohort, rows, periods, comparable: periods.length === 1 };
});
const modelState = demandAggregation.ready ? 'computed' : 'insufficient';
const verdict = demandAggregation.ready ? '観測済み / 因果は未接続' : '観測不足';
const blockers = [
  ['β', '顧客投資 → 半導体売上の変換係数'],
  ['LAG', '投資から売上認識までの時間差'],
  ['MARGIN', '将来の半導体利益率'],
  ['WEIGHT', '指数・企業別の寄与ウェイト'],
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="AI・クラウド顧客の資金余力から半導体利益の持続性を検証する、一次情報ベースのリサーチダッシュボード。" />
    <title>Semiconductor Earnings Model / Research Terminal</title>
  </head>
  <body class="model-terminal">
    <div class="app-shell">
      <aside class="rail" aria-label="モデル内ナビゲーション">
        <a class="rail-brand" href={`${base}earnings/`} aria-label="一次情報台帳へ">
          <span class="rail-mark">K</span>
          <span>SEMIS</span>
        </a>
        <nav class="rail-nav">
          <a class="active" href="#summary"><span>01</span>Summary</a>
          <a href="#funding"><span>02</span>Funding</a>
          <a href="#companies"><span>03</span>Companies</a>
          <a href="#model"><span>04</span>Model</a>
          <a href="#evidence"><span>05</span>Evidence</a>
        </nav>
        <div class="rail-meta">
          <span>DATA</span>
          <strong>SEC EDGAR</strong>
          <small>deterministic</small>
        </div>
      </aside>

      <main class="workspace">
        <header class="commandbar">
          <div class="crumbs">
            <a href={`${base}earnings/`}>Ledger</a>
            <span>/</span>
            <strong>Model</strong>
          </div>
          <div class="command-actions">
            <span class="live-pill"><i></i>PRIMARY FACTS</span>
            <a href={`${base}api/v1/demand/index.json`}>API</a>
          </div>
        </header>

        <section id="summary" class="summary">
          <div class="title-row">
            <div>
              <p class="eyebrow">SEMICONDUCTOR EARNINGS / DEMAND-SIDE FUNDING</p>
              <h1>AI投資は、<br /><span>半導体利益を支え続けられるか。</span></h1>
              <p class="intro">
                顧客の営業CFとCapExを先に確認し、その資金余力が半導体売上・利益へ接続できるかを判定する画面です。
                観測値・派生値・未入力を分離し、係数がない区間は予測しません。
              </p>
            </div>
            <aside class="decision-card" data-aggregation-status={modelState}>
              <div class="decision-head">
                <span>CURRENT VERDICT</span>
                <b class:list={{ ready: demandAggregation.ready }}>{demandAggregation.ready ? 'DATA READY' : 'WAIT'}</b>
              </div>
              <strong>{verdict}</strong>
              <p>
                顧客資金は比較できます。ただし顧客投資から半導体利益へ渡す係数が未登録のため、
                2027年利益成長率はまだ出しません。
              </p>
              <a href="#model">不足している入力を見る →</a>
            </aside>
          </div>

          <div class="kpi-strip" aria-label="主要指標">
            <article>
              <span>COMMON PERIOD</span>
              <strong>{commonDemandCompanies.length}<small>社</small></strong>
              <p>{dateJP(commonDemandPeriod)}</p>
            </article>
            <article>
              <span>OPERATING CF</span>
              <strong>{usd(demandAggregation.totalOcf)}</strong>
              <p>同一期間の総和</p>
            </article>
            <article>
              <span>CAPEX DEFINITIONS</span>
              <strong>{demandAggregation.tagTotals.length}<small>種</small></strong>
              <p>タグ混在は合算しない</p>
            </article>
            <article>
              <span>COMPARABLE COHORTS</span>
              <strong>{comparableCohorts.length}<small>群</small></strong>
              <p>負担率を比較可能</p>
            </article>
            <article>
              <span>SEMICONDUCTOR HISTORY</span>
              <strong>{profitHistoryQuarters}<small>Q</small></strong>
              <p>{profitCompanies.length}社を収録</p>
            </article>
          </div>

          <div class="reading-guide">
            <span>この画面の読み方</span>
            <ol>
              <li><b>1</b> 顧客に投資余力があるか</li>
              <li><b>2</b> その投資が半導体需要へ何割流れるか</li>
              <li><b>3</b> 売上が利益へ何割残るか</li>
            </ol>
            <p>現在は <strong>1まで実測</strong>。2と3は入力待ちです。</p>
          </div>
        </section>

        <section id="funding" class="panel-section">
          <div class="section-head">
            <div>
              <span class="section-index">02 / FUNDING CAPACITY</span>
              <h2>顧客の資金余力</h2>
              <p>同じ期間の営業CFとCapExをコホート別に比較。まず「投資を続ける現金があるか」を見ます。</p>
            </div>
            <div class="legend">
              <span><i class="ocf-dot"></i>Operating CF</span>
              <span><i class="capex-dot"></i>CapEx</span>
            </div>
          </div>

          <div class="funding-grid">
            <div class="chart-panel">
              <div class="panel-title">
                <div><span>COHORT VIEW</span><strong>Funding capacity</strong></div>
                <small>{dateJP(commonDemandPeriod)}</small>
              </div>
              <div class="cohort-bars">
                {demandAggregation.cohorts.map((cohort) => (
                  <article class="cohort-line">
                    <header>
                      <div><strong>{cohort.label}</strong><span>{cohort.rows.length} companies</span></div>
                      <b>{cohort.comparableBurden == null ? 'mixed tag' : `${(cohort.comparableBurden * 100).toFixed(1)}% burden`}</b>
                    </header>
                    <div class="bar-line">
                      <label>OCF</label>
                      <div class="track"><i class="bar ocf" style={`width:${aggregateBar(cohort.ocf)}`}></i></div>
                      <span>{usd(cohort.ocf)}</span>
                    </div>
                    <div class="bar-line">
                      <label>CapEx</label>
                      <div class="track stacked">
                        {cohort.tags.map((tag) => <i class:list={['bar', 'capex', `tag-${tag.colorIndex % 3}`]} style={`width:${aggregateBar(tag.total)}`}></i>)}
                      </div>
                      <span>{cohort.tags.length === 1 ? usd(cohort.tags[0].total) : 'tag split'}</span>
                    </div>
                  </article>
                ))}
              </div>
            </div>

            <aside class="interpretation-panel">
              <div class="panel-title">
                <div><span>INTERPRETATION</span><strong>何が分かったか</strong></div>
              </div>
              <div class="signal-list">
                <article>
                  <span class="state observed">A</span>
                  <div><strong>営業CFは観測済み</strong><p>{commonDemandCompanies.length}社を共通期間で合算できます。</p></div>
                </article>
                <article>
                  <span class="state derived">D</span>
                  <div><strong>FCF・負担率は派生可能</strong><p>会社単位、同一タグのコホート単位でのみ計算します。</p></div>
                </article>
                <article>
                  <span class="state missing">?</span>
                  <div><strong>半導体への配分率は不明</strong><p>CapExの全額を半導体需要とみなすことはしません。</p></div>
                </article>
              </div>
              <div class="definition-note">
                <span>WHY TAGS MATTER</span>
                <p>CapExはXBRL定義が企業で異なります。異なるタグを一つの「設備投資」に潰さず、比較可能性を優先しています。</p>
              </div>
            </aside>
          </div>
        </section>

        <section id="companies" class="panel-section">
          <div class="section-head">
            <div>
              <span class="section-index">03 / COMPANY ACTUALS</span>
              <h2>会社別 Actuals</h2>
              <p>Koyfin型の「まず一覧、必要なら一次資料へ」の導線。A=一次fact、D=この画面での派生値です。</p>
            </div>
            <div class="table-key"><span class="state observed">A</span> actual <span class="state derived">D</span> derived</div>
          </div>

          <div class="data-table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Company</th>
                  <th>Role</th>
                  <th>Period</th>
                  <th>OCF <em>A</em></th>
                  <th>CapEx <em>A</em></th>
                  <th>FCF <em>D</em></th>
                  <th>Burden <em>D</em></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {demandCompanies.map((company) => (
                  <tr>
                    <td>
                      <strong>{company.name}</strong>
                      <div class="mini-bar"><i style={`width:${cashBar(latestDemand(company).operating_cash_flow.value_usd)}`}></i></div>
                    </td>
                    <td><span class="role-pill">{roleJP[company.role] || company.role}</span></td>
                    <td>{dateJP(latestDemand(company).period_end)}</td>
                    <td>{usd(latestDemand(company).operating_cash_flow.value_usd)}</td>
                    <td>{usd(latestDemand(company).capital_expenditures.value_usd)}</td>
                    <td class:list={{ negative: fcf(company) < 0 }}>{usd(fcf(company))}</td>
                    <td class:list={{ hot: (burden(company) ?? 0) > 100 }}>{pct(burden(company))}</td>
                    <td><a class="row-link" href={latestDemand(company).operating_cash_flow.source_url} target="_blank" rel="noreferrer">SEC ↗</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="cohort-notes">
            {cohortRows.map((cohort) => (
              <article>
                <span>{cohort.label}</span>
                <strong>{cohort.rows.length}社</strong>
                <p>{cohort.periods.map(dateJP).join(' · ') || 'factなし'}</p>
                <b class:list={{ mismatch: !cohort.comparable }}>{cohort.comparable ? 'period aligned' : 'period mismatch'}</b>
              </article>
            ))}
          </div>
        </section>

        <section id="model" class="panel-section">
          <div class="section-head">
            <div>
              <span class="section-index">04 / MODEL PIPELINE</span>
              <h2>どこまで計算できるか</h2>
              <p>説明文ではなく、モデルの「通っている区間」と「止まっている区間」を一目で示します。</p>
            </div>
          </div>

          <div class="pipeline">
            <article class="stage complete">
              <header><span>01</span><b>OBSERVED</b></header>
              <strong>顧客の資金余力</strong>
              <p>OCF / CapEx / 会社別FCF</p>
              <footer><i></i>ready</footer>
            </article>
            <div class="connector complete"><span>→</span></div>
            <article class="stage blocked">
              <header><span>02</span><b>ALLOCATION</b></header>
              <strong>半導体への配分</strong>
              <p>β × 顧客投資 × ラグ</p>
              <footer><i></i>missing inputs</footer>
            </article>
            <div class="connector blocked"><span>→</span></div>
            <article class="stage blocked">
              <header><span>03</span><b>PROFIT</b></header>
              <strong>売上から利益へ</strong>
              <p>売上 × 将来利益率</p>
              <footer><i></i>missing margin</footer>
            </article>
            <div class="connector blocked"><span>→</span></div>
            <article class="stage blocked">
              <header><span>04</span><b>INDEX</b></header>
              <strong>指数利益成長</strong>
              <p>企業利益 × ウェイト</p>
              <footer><i></i>not calculated</footer>
            </article>
          </div>

          <div class="blocker-grid">
            <div class="blocker-head">
              <span>REQUIRED INPUTS</span>
              <strong>あと4種類の入力でモデルが接続</strong>
              <p>仮定をコードへ埋め込まず、登録された入力だけで前進します。</p>
            </div>
            <div class="blocker-list">
              {blockers.map(([code, text]) => (
                <article><b>{code}</b><span>{text}</span><i>missing</i></article>
              ))}
            </div>
          </div>

          <details class="formula-drawer">
            <summary>
              <span><small>FORMULAS</small><strong>計算式を確認</strong></span>
              <b>＋</b>
            </summary>
            <div class="formula-grid">
              <article><span>会社別 FCF</span><code>FCFᵢ = OCFᵢ − CapExᵢ</code><p>同一会社・同一期間のみ。</p></article>
              <article><span>投資負担率</span><code>burdenᵢ = CapExᵢ ÷ OCFᵢ</code><p>異なるCapExタグは統合しない。</p></article>
              <article><span>将来投資余力</span><code>I₁ᵢ = OCF₀ᵢ × (1 + gOCFᵢ) × (1 − mFCFᵢ + fᵢ)</code><p>gOCF / mFCF / f が未登録。</p></article>
              <article><span>半導体利益</span><code>Profit₁ = Σ(I₁ᵢ × βᵢ × lagᵢ) × margin₁</code><p>β / lag / margin が未登録。</p></article>
            </div>
          </details>
        </section>

        <section id="evidence" class="panel-section evidence-section">
          <div class="section-head">
            <div>
              <span class="section-index">05 / EVIDENCE & PROVENANCE</span>
              <h2>数字の出所</h2>
              <p>ページ内の実測値はSEC EDGAR Companyfactsを起点にし、派生計算とbuildを追跡できます。</p>
            </div>
          </div>

          <div class="evidence-grid">
            <article>
              <span>DEMAND API</span>
              <strong>{demandCompanies.length} companies</strong>
              <code>{demandApi.content_hash}</code>
              <a href={`${base}api/v1/demand/index.json`}>JSONを開く ↗</a>
            </article>
            <article>
              <span>SEMICONDUCTOR PROFIT API</span>
              <strong>{profitCompanies.length} companies</strong>
              <code>{profitApi.content_hash}</code>
              <a href={`${base}api/v1/semiconductor-profit/index.json`}>JSONを開く ↗</a>
            </article>
            <article>
              <span>BUILD</span>
              <strong>GitHub Pages</strong>
              <code data-build-sha={buildSha}>{buildSha}</code>
              <a href="https://www.sec.gov/edgar/sec-api-documentation" target="_blank" rel="noreferrer">SEC API仕様 ↗</a>
            </article>
          </div>

          <div class="boundary">
            <span>MODEL BOUNDARY</span>
            <p>
              この画面が答えるのは「顧客の資金余力がどこまで観測できているか」です。
              「その資金が半導体利益を何%押し上げるか」は、β・ラグ・将来利益率・ウェイトが登録されるまで答えません。
            </p>
          </div>
        </section>

        <footer class="workspace-footer">
          <span>SEMICONDUCTOR EARNINGS MODEL</span>
          <span>Actual → Derived → Missing → Verdict</span>
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body.model-terminal) {
    margin: 0 !important;
    color: #14171b !important;
    background: #eef0f2 !important;
    background-image: none !important;
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Yu Gothic", sans-serif !important;
    letter-spacing: 0 !important;
  }
  :global(body.model-terminal::before) { display: none !important; }
  :global(.model-terminal a) { color: inherit; }

  .app-shell { min-height: 100vh; display: grid; grid-template-columns: 176px minmax(0, 1fr); }
  .rail {
    position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column;
    padding: 20px 14px; color: #eef2f5; background: #101318; border-right: 1px solid #242a31;
  }
  .rail-brand { display: flex; align-items: center; gap: 10px; padding: 5px 8px 24px; font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-decoration: none; }
  .rail-mark { display: grid; place-items: center; width: 28px; height: 28px; color: #0b1711; background: #63e6a2; border-radius: 4px; font-size: .75rem; font-weight: 900; }
  .rail-nav { display: grid; gap: 4px; }
  .rail-nav a { display: grid; grid-template-columns: 24px 1fr; gap: 8px; align-items: center; min-height: 38px; padding: 0 9px; color: #8f9aa6; border-radius: 5px; font-size: .72rem; font-weight: 650; text-decoration: none; }
  .rail-nav a span { color: #59636e; font: 600 .55rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  .rail-nav a:hover, .rail-nav a.active { color: #f5f7f8; background: #1a1f25; }
  .rail-nav a.active span { color: #63e6a2; }
  .rail-meta { margin-top: auto; padding: 14px 9px 4px; border-top: 1px solid #252a31; }
  .rail-meta span { display: block; color: #59636e; font: 700 .52rem ui-monospace, monospace; letter-spacing: .12em; }
  .rail-meta strong { display: block; margin-top: 6px; color: #c9d0d6; font-size: .66rem; }
  .rail-meta small { display: block; margin-top: 4px; color: #68727c; font-size: .58rem; }

  .workspace { min-width: 0; background: #f5f6f7; }
  .commandbar {
    position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between;
    min-height: 52px; padding: 0 clamp(18px, 3vw, 42px); background: rgba(245,246,247,.94);
    border-bottom: 1px solid #d8dde1; backdrop-filter: blur(12px);
  }
  .crumbs, .command-actions { display: flex; align-items: center; gap: 9px; color: #77818b; font-size: .68rem; }
  .crumbs a, .command-actions a { text-decoration: none; }
  .crumbs strong { color: #22272d; }
  .command-actions a { padding-left: 10px; border-left: 1px solid #d3d7db; color: #37414a; font-weight: 700; }
  .live-pill { display: inline-flex; align-items: center; gap: 7px; color: #3d4a43; font: 700 .55rem ui-monospace, monospace; letter-spacing: .06em; }
  .live-pill i { width: 7px; height: 7px; border-radius: 50%; background: #36c77b; box-shadow: 0 0 0 3px rgba(54,199,123,.13); }

  .summary, .panel-section, .workspace-footer { width: min(1440px, calc(100% - 56px)); margin-inline: auto; }
  .summary { padding: 54px 0 34px; }
  .title-row { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .75fr); gap: clamp(24px, 4vw, 56px); align-items: end; }
  .eyebrow, .section-index, .decision-head, .kpi-strip span, .panel-title span, .definition-note span, .blocker-head > span, .evidence-grid > article > span, .boundary > span {
    color: #7f8993; font: 700 .56rem ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .1em; text-transform: uppercase;
  }
  h1, h2 { margin: 0; color: #111419 !important; font-family: inherit !important; letter-spacing: -.045em !important; }
  h1 { max-width: 900px; font-size: clamp(2.6rem, 5.4vw, 5.45rem); line-height: .98; font-weight: 760; }
  h1 span { color: #59636c; font-weight: 600; }
  .intro { max-width: 760px; margin: 24px 0 0; color: #56616b; font-size: .93rem; line-height: 1.85; }
